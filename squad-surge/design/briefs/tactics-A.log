let flashTimer = 0;
function flashRed() { const f = $("flash"); f.style.opacity = 1; clearTimeout(flashTimer); flashTimer = setTimeout(() => f.style.opacity = 0, 140); }
const STAR_PATH = "M12 2l3 6.5 7 .8-5.2 4.8 1.4 7L12 17.6 5.8 21l1.4-7L2 9.3l7-.8z";
function starIcons(n) { return [0, 1, 2].map(i => `<svg viewBox="0 0 24 24"><path d="${STAR_PATH}" fill="${i < n ? "#ffd84a" : "#3a4a78"}" stroke="#0d1630" stroke-width="1.5"/></svg>`).join(""); }
function renderLevels() {
  const grid = $("lvgrid"); grid.innerHTML = "";
  const last = Math.max(12, Math.ceil((save.unlocked + 1) / 3) * 3);
  for (let n = 1; n <= last; n++) {
    const b = document.createElement("button"), open = n <= save.unlocked;
    b.className = "lvtile" + (n === save.level ? " cur" : ""); b.disabled = !open;
    b.innerHTML = open ? `<b class="stroke">${n}</b><small>${levelName(n)}</small><span class="st">${starIcons(save.stars[n] || 0)}</span>` : `<b>🔒</b><small>${n}</small>`;
    b.setAttribute("aria-label", open ? `Level ${n}, ${levelName(n)}, ${save.stars[n] || 0} stars` : `Level ${n}, locked`);
