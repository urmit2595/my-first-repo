  on("soldiersAdded", d => { if (d.total != null) { S().maxSquad = Math.max(S().maxSquad, d.total); feed("squad", d.total); } });
  on("squadMilestone", d => { if (d.n) S().maxSquad = Math.max(S().maxSquad, d.n); });
  on("soldiersLost", d => {
