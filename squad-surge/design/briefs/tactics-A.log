// ---------- instanced sprite layers ----------
const SPRITE_VS = `
#include <fog_pars_vertex>
attribute vec3 aOff; attribute vec2 aScale; attribute vec3 aFrame;
uniform vec2 grid; varying vec2 vUv; varying float vA; varying float vFlash;
void main(){
  vec4 mvPosition = modelViewMatrix * vec4(aOff, 1.0);
  mvPosition.xy += position.xy * aScale;
  gl_Position = projectionMatrix * mvPosition;
  float f = aFrame.x; float c = mod(f, grid.x); float r = floor(f / grid.x + 0.001);
  vUv = vec2((c + uv.x) / grid.x, 1.0 - (r + 1.0 - uv.y) / grid.y);
  vA = aFrame.y; vFlash = aFrame.z;
  #include <fog_vertex>
}`;
const SPRITE_FS = `
#include <fog_pars_fragment>
uniform sampler2D map; uniform vec3 tint; uniform vec4 recolor; varying vec2 vUv; varying float vA; varying float vFlash;
vec3 rgb2hsv(vec3 c){ vec4 K = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x); }
vec3 hsv2rgb(vec3 c){ vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0); return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y); }
void main(){
  vec4 t = texture2D(map, vUv);
  if (t.a * vA < 0.5) discard;
  vec3 col = t.rgb;
  if (recolor.w > 0.5) { // squad colour: re-hue only the blue uniform and helmet
    vec3 h = rgb2hsv(col);
    float m = (1.0 - smoothstep(0.05, 0.11, abs(h.x - 0.6))) * smoothstep(0.18, 0.32, h.y);
    col = mix(col, hsv2rgb(vec3(recolor.x, clamp(h.y * recolor.y, 0.0, 1.0), clamp(h.z * recolor.z, 0.0, 1.0))), m);
  }
  gl_FragColor = vec4(mix(col * tint, vec3(1.0), vFlash), 1.0);
  #include <fog_fragment>
}`;
const FX_FS = `
#include <fog_pars_fragment>
uniform sampler2D map; uniform vec3 tracer; varying vec2 vUv; varying float vA; varying float vFlash;
void main(){
  vec4 t = texture2D(map, vUv); vec3 c = t.rgb * vA;
  if (vFlash > 0.5) c *= tracer; // bullets are pushed with flash = 1: tint them with the tracer colour
  gl_FragColor = vec4(c, 1.0);
  #ifdef USE_FOG
    gl_FragColor.rgb *= 1.0 - smoothstep(fogNear, fogFar, fogDepth); // additive: fade out instead of tinting
  #endif
}`;
const spriteLayers = [];
class SpriteLayer {
  constructor(tex, cols, rows, max, { additive = false, anchor = 0 } = {}) {
    const base = new THREE.PlaneBufferGeometry(1, 1); base.translate(0, 0.5 - anchor, 0);
    const g = new THREE.InstancedBufferGeometry();
    g.index = base.index; g.setAttribute("position", base.attributes.position); g.setAttribute("uv", base.attributes.uv);
    this.off = new Float32Array(max * 3); this.sc = new Float32Array(max * 2); this.fr = new Float32Array(max * 3);
    this.aOff = new THREE.InstancedBufferAttribute(this.off, 3).setUsage(THREE.DynamicDrawUsage);
    this.aSc = new THREE.InstancedBufferAttribute(this.sc, 2).setUsage(THREE.DynamicDrawUsage);
    this.aFr = new THREE.InstancedBufferAttribute(this.fr, 3).setUsage(THREE.DynamicDrawUsage);
    g.setAttribute("aOff", this.aOff); g.setAttribute("aScale", this.aSc); g.setAttribute("aFrame", this.aFr);
    g.instanceCount = 0;
    const uniforms = THREE.UniformsUtils.merge([THREE.UniformsLib.fog]); // merge first: it would clone a texture value
    Object.assign(uniforms, { map: { value: tex }, grid: { value: new THREE.Vector2(cols, rows) }, tint: { value: new THREE.Color(1, 1, 1) }, recolor: { value: new THREE.Vector4(0, 1, 1, 0) }, tracer: { value: new THREE.Vector3(1, 1, 1) } });
    const mat = new THREE.ShaderMaterial({
      uniforms, fog: true,
      vertexShader: SPRITE_VS, fragmentShader: additive ? FX_FS : SPRITE_FS,
      transparent: additive, depthWrite: !additive, blending: additive ? THREE.AdditiveBlending : THREE.NormalBlending,
    });
    this.mesh = new THREE.Mesh(g, mat); this.mesh.frustumCulled = false; this.mesh.renderOrder = additive ? 5 : 1;
    this.g = g; this.max = max; this.n = 0; this.additive = additive; scene.add(this.mesh); spriteLayers.push(this);
  }
  begin() { this.n = 0; }
  push(x, y, z, w, h, frame, alpha = 1, flash = 0) {
    if (this.n >= this.max) return;
    const i = this.n++;
    this.off[i * 3] = x; this.off[i * 3 + 1] = y; this.off[i * 3 + 2] = z;
    this.sc[i * 2] = w; this.sc[i * 2 + 1] = h;
    this.fr[i * 3] = frame; this.fr[i * 3 + 1] = alpha; this.fr[i * 3 + 2] = flash;
  }
  end() { this.g.instanceCount = this.n; this.aOff.needsUpdate = this.aSc.needsUpdate = this.aFr.needsUpdate = true; }
}
// flat blob shadows on the ground
class ShadowLayer {
  constructor(max) {
    const c = document.createElement("canvas"); c.width = c.height = 64;
    const x = c.getContext("2d"), gr = x.createRadialGradient(32, 32, 0, 32, 32, 32);
    gr.addColorStop(0, "rgba(0,0,0,.62)"); gr.addColorStop(0.35, "rgba(0,0,0,.5)"); gr.addColorStop(1, "rgba(0,0,0,0)"); x.fillStyle = gr; x.fillRect(0, 0, 64, 64);
    const base = new THREE.PlaneBufferGeometry(1, 1); base.rotateX(-Math.PI / 2);
    this.mesh = new THREE.InstancedMesh(base, new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(c), transparent: true, depthWrite: false }), max);
    this.mesh.frustumCulled = false; this.mesh.renderOrder = 0; this.max = max; this.m = new THREE.Matrix4(); scene.add(this.mesh);
  }
  begin() { this.n = 0; }
  push(x, z, s) { if (this.n >= this.max) return; this.m.makeScale(s, 1, s * 0.7); this.m.setPosition(x, 0.03, z); this.mesh.setMatrixAt(this.n++, this.m); }
  end() { this.mesh.count = this.n; this.mesh.instanceMatrix.needsUpdate = true; }
}

// ---------- label textures (numbers on gates / blocks) ----------
function makeLabel(w, h) {
  const c = document.createElement("canvas"); c.width = w; c.height = h;
  const tex = new THREE.CanvasTexture(c); tex.anisotropy = 4;
  return { c, ctx: c.getContext("2d"), tex, last: null };
}
function drawLabel(L, text, color = "#fff", size = 0.62) {
  if (L.last === text) return; L.last = text;
  const { ctx, c } = L; ctx.clearRect(0, 0, c.width, c.height);
  ctx.font = `${Math.round(c.height * size)}px 'Lilita One', sans-serif`; ctx.textAlign = "center"; ctx.textBaseline = "middle";
  ctx.lineJoin = "round"; ctx.lineWidth = c.height * 0.12; ctx.strokeStyle = "#0d1630";
  ctx.strokeText(text, c.width / 2, c.height * 0.54); ctx.fillStyle = color; ctx.fillText(text, c.width / 2, c.height * 0.54);
  L.tex.needsUpdate = true;
}

// ---------- audio ----------
let actx = null;
function sfx(type, pitch = 1) {
  if (!save.sound) return;
  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    const t = actx.currentTime, o = actx.createOscillator(), g = actx.createGain();
    const cfg = { shot: [520, 180, 0.03, 0.035, "square"], hit: [220, 90, 0.05, 0.05, "triangle"], gate: [500, 1000, 0.18, 0.12, "sine"], bad: [300, 110, 0.25, 0.12, "sawtooth"], boom: [120, 40, 0.35, 0.2, "sawtooth"], coin: [900, 1500, 0.1, 0.08, "sine"], pop: [700, 380, 0.07, 0.045, "triangle"], rocket: [180, 70, 0.12, 0.06, "sawtooth"], win: [440, 880, 0.5, 0.15, "triangle"] }[type];
    o.type = cfg[4]; o.frequency.setValueAtTime(cfg[0] * pitch, t); o.frequency.exponentialRampToValueAtTime(cfg[1] * pitch, t + cfg[2]);
    g.gain.setValueAtTime(cfg[3], t); g.gain.exponentialRampToValueAtTime(0.0001, t + cfg[2]);
    o.connect(g).connect(actx.destination); o.start(t); o.stop(t + cfg[2] + 0.02);
  } catch (e) { console.warn("audio unavailable", e); save.sound = false; }
}
const vibe = ms => { if (save.vibe && navigator.vibrate) navigator.vibrate(ms); };

// ---------- RNG ----------
function rng(seed) { return () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; }; }

// ---------- world / level ----------
let L = null;               // current level state
const world = new THREE.Group(); scene.add(world);   // scenery, owned by js/scenery.js
const track = new THREE.Group(); scene.add(track);   // gate and solid visuals, owned by js/objects3d.js
// event bus: the game emits, the look-and-feel modules listen (design/overhaul.md section 6)
const bus = {
  h: {},
  on(name, fn) { (this.h[name] ||= []).push(fn); },
  emit(name, data) { const hs = this.h[name]; if (hs) for (const fn of hs) { try { fn(data); } catch (e) { console.error(`bus ${name}`, e); } } },
};
const spriteTint = new THREE.Color(1, 1, 1);
function setSpriteTint(color) { spriteTint.set(color); for (const l of spriteLayers) if (!l.additive) l.mesh.material.uniforms.tint.value.copy(spriteTint); }
const ctx = {
  THREE, renderer, scene, camera, world, track, ROAD, TEX, bus, save, $, gameEl, makeLabel, drawLabel, setSpriteTint, rng,
  get WEAPONS() { return WEAPONS; }, get L() { return L; }, get state() { return state; }, get layers() { return layers; },
  sfx: (...a) => sfx(...a), vibe: ms => vibe(ms), floatText: (...a) => floatText(...a),
  // Surge Update seams (design/engagement.md section 3)
  slowMo: (...a) => slowMo(...a), hitStop: s => hitStop(s), addScore: (p, o) => addScore(p, o),
  spawnSolid: (...a) => spawnSolid(...a), damageArea: (...a) => damageArea(...a),
  addSoldiers: n => addSoldiers(n), killSoldiers: (n, nearX = null, force = true) => killSoldiers(n, nearX, force),
  setShield: s => setShield(s), setGiant: s => setGiant(s), finishLevel: m => finishLevel(m), goMode: o => goMode(o),
  setSkin: (a, b) => setSkin(a, b), squadRadius: n => squadRadius(n), persist: () => persist(), MODIFIERS, SKINS, TRACERS, SPEED, COMBO_TIERS,
};
const SLAM_R = 3.0, SLAM_WARN = 1.6, SLAM_AT = 2.6; // boss slam: red ring warns, then hits soldiers inside it
const slamRing = new THREE.Mesh(new THREE.RingBufferGeometry(SLAM_R - 0.5, SLAM_R, 48), new THREE.MeshBasicMaterial({ color: 0xff2a1a, transparent: true, depthWrite: false }));
slamRing.rotation.x = -Math.PI / 2; slamRing.renderOrder = 2; slamRing.visible = false; scene.add(slamRing);
const slamFill = new THREE.Mesh(new THREE.CircleBufferGeometry(SLAM_R - 0.5, 48), new THREE.MeshBasicMaterial({ color: 0xff2a1a, transparent: true, opacity: 0.18, depthWrite: false }));
slamFill.rotation.x = -Math.PI / 2; slamFill.renderOrder = 2; slamFill.visible = false; scene.add(slamFill);
const slamCenter = b => [b.x, b.z + 7];
let layers = null;          // sprite layers
const floatsEl = $("floats");
const tmpV = new THREE.Vector3(), lookAt = new THREE.Vector3();
const CHAR_K = 1.15, SOLDIER_H = 1.3 * CHAR_K, BOSS_H = 9.5; // visual sizes only; hit boxes are unchanged
const SHADOW_DX = 0.25, SHADOW_DZ = 0.3;                        // blob shadows lean away from the sun

const LEVEL_NAMES = ["OLD TOWN", "RED BRIDGE", "SALT PIER", "BROKEN BLOCKS", "DUNE ROAD", "IRON ARENA", "MARKET STREET", "STORM BRIDGE", "FOG HARBOR", "ASH DISTRICT", "SUN CANYON", "LAST STAND"];
function levelName(level) { const lap = Math.ceil(level / LEVEL_NAMES.length); return LEVEL_NAMES[(level - 1) % LEVEL_NAMES.length] + (lap > 1 ? ` ${lap}` : ""); }
function themeFor(level) { return THEMES[(level - 1) % THEMES.length]; }

// ---------- level generation ----------
const isGood = h => h.op === "x" ? h.v >= 1 : h.v >= 0;
const gateText = h => h.op === "x" ? `x${h.v}` : (h.v > 0 ? `+${h.v}` : `${h.v}`);
function makeGate(z, left, right) {
  const gate = { kind: "gate", z, used: false, halves: [] };
  for (const [s, spec] of [[-1, left], [1, right]]) gate.halves.push({ x: s * ROAD / 2, hw: ROAD / 2, op: spec[0], v: spec[1], side: s, jackpot: !!(spec[2] && spec[2].jackpot) });
  Obj3D.gate(gate); refreshGate(gate); return gate;
}
function refreshGate(gate) { for (const h of gate.halves) Obj3D.gateHalf(gate, h, isGood(h), gateText(h)); }
// solid shootable objects: blocks, crates, tyres, weapon cases, ammo boxes (hw = half-width for bullets and collisions)
const SOLID_HW = { blockBlue: 1.1, blockYellow: 1.2, crate: 1.2, tyres: 0.9, ammo: 1.05, weaponCase: 1.3, airdrop: 1.2, barrel: 0.8 };
function makeSolid(kind, x, z, hp, extra = {}) {
  const o = { kind, x, z, hw: SOLID_HW[kind], hp, maxHp: hp, alive: true, ...extra };
  Obj3D.solid(o); labelSolid(o); return o;
}
function labelSolid(o) {
  if (o.kind === "blockBlue" || o.kind === "blockYellow") Obj3D.solidLabel(o, `+${o.reward}`, "#fff");
  else Obj3D.solidLabel(o, `${Math.ceil(o.hp)}`, o.kind === "weaponCase" || o.kind === "airdrop" ? "#ffe066" : o.kind === "ammo" ? "#9dff7a" : o.kind === "barrel" ? "#ff9a7a" : "#fff");
}
function enemy(type, x, z, level) {
  const hpScale = 1 + (level - 1) * 0.1;
  const def = { zombie: { hp: 2, r: 0.42, h: 1.45, sp: 2.6, dmg: 1 }, grunt: { hp: 2, r: 0.42, h: 1.45, sp: 3.2, dmg: 1 }, brute: { hp: 22, r: 0.85, h: 2.3, sp: 2.2, dmg: 5 } }[type];
  return { type, x, z, hp: def.hp * hpScale, maxHp: def.hp * hpScale, r: def.r, h: def.h, sp: def.sp * (0.85 + Math.random() * 0.3), dmg: def.dmg, state: "idle", t: Math.random() * 4, flash: 0, dieT: 0 };
}
function generateLevel(level, opts = {}) {
  const theme = themeFor(level), seeded = opts.seed !== undefined;
  const r = seeded ? rng(opts.seed * 7919 + level * 131) : rng(level * 9973 + 17);
  const rj = rng((seeded ? opts.seed : level) * 7777 + 3); // jackpots use their own stream so layouts stay the same
  const mod = opts.modifier, hordeMul = mod === "horde" ? 1.7 : 1, blockMul = mod === "lone" ? 2 : 1;
  const jackChance = mod === "jackpot" ? 0.45 : 0.08;
  let needJackpot = !seeded && (level === 2 || (save.jackDry || 0) >= 3), jackpots = 0; // first one in level 2, then never 3 dry levels
  const length = Math.min(200 + level * 35, 520);
  Obj3D.clear(); Scenery.build(theme, length);
  const gates = [], solids = [], enemies = [];
  const etype = theme.enemy, d = level;
  const horde = (z, n, spread = 4.2, depth = 6) => {
    n = Math.round(n * hordeMul);
    for (let i = 0; i < n; i++) enemies.push(enemy(etype, (r() * 2 - 1) * spread, z - r() * depth, level));
    if (mod === "brutes") enemies.push(enemy("brute", (rj() * 2 - 1) * 3, z - depth * 0.5, level));
  };
  let z = -26;
  if (level === 1) { // tutorial: shoot the gate up, small hordes, one lane strip, case, tiny boss
    gates.push(makeGate(z, ["+", -5], ["+", 4])); z -= 30;
    horde(z, 5, 3); z -= 26;
    gates.push(makeGate(z, ["x", 2], ["+", -3])); z -= 24;
    for (let i = 0; i < 6; i++) solids.push(makeSolid("blockBlue", -4.6, z - i * 2.6, 3, { reward: 1 }));
    horde(z - 4, 8, 2.2, 10); z -= 32;
    solids.push(makeSolid("weaponCase", 3.3, z, 30, { weapon: 1 })); solids.push(makeSolid("ammo", -3.3, z, 18, { ammo: true })); horde(z - 6, 8, 3); z -= 30;
    gates.push(makeGate(z, ["+", 6], ["+", -8])); z -= 26;
    horde(z, 16, 4.5, 10);
  } else {
    // every level opens with a free boost so the squad isn't wiped by the first wave
    gates.push(makeGate(z, ["+", 4 + d], ["+", 8 + d])); z -= 26;
    const pool = ["gates", "horde", "lanes", "tyres", "gates", "case", "brutes", "horde", "ammo"];
    while (z > -length + 30) {
      const seg = pool[Math.floor(r() * pool.length)];
      if (seg === "gates") {
        const good = [["+", 5 + Math.floor(r() * 5 * d)], ["x", 2], ["+", 10 + d * 3]], bad = [["+", -(2 + Math.floor(r() * 2 * d))], ["x", 1], ["+", -(5 + d)]];
        const pair = r() < 0.5 ? [good[Math.floor(r() * 3)], bad[Math.floor(r() * 3)]] : [bad[Math.floor(r() * 3)], good[Math.floor(r() * 3)]];
        if ((needJackpot && !jackpots) || rj() < jackChance) { // golden jackpot half replaces the good one
          const gi = pair[0][1] >= 0 && pair[0][0] === "+" || (pair[0][0] === "x" && pair[0][1] > 1) ? 0 : 1;
          pair[gi] = rj() < 0.4 ? ["x", 4, { jackpot: true }] : ["+", 40 + 8 * d, { jackpot: true }]; jackpots++;
        }
        gates.push(makeGate(z, pair[0], pair[1])); z -= 22;
      } else if (seg === "horde") { horde(z, 6 + d * 3, 4.5, 8 + d); z -= 24 + d; }
      else if (seg === "lanes") { // the ad's layout: +1 column left, crate + +99 column right, horde in the middle
        const n = 6 + Math.floor(d / 2);
        for (let i = 0; i < n; i++) solids.push(makeSolid("blockBlue", -4.6, z - i * 2.6, 3 + d, { reward: (1 + Math.floor(d / 3)) * blockMul }));
        solids.push(makeSolid("crate", 4.5, z, 25 + d * 10, {}));
        for (let i = 0; i < 3; i++) solids.push(makeSolid("blockYellow", 4.5, z - 3 - i * 2.8, 18 + d * 6, { reward: 10 + d * 5 }));
        horde(z - 2, 8 + d * 3, 2.4, n * 2.6); z -= n * 2.6 + 18;
      } else if (seg === "tyres") {
        for (const x of [-3.6, 0, 3.6]) if (r() < 0.75) solids.push(makeSolid("tyres", x, z, 10 + d * 5, {}));
        z -= 18;
      } else if (seg === "ammo") {
        solids.push(makeSolid("ammo", (r() < 0.5 ? -1 : 1) * 3.3, z, 20 + d * 8, { ammo: true }));
        horde(z - 4, 4 + d, 2, 4); z -= 22;
      } else if (seg === "case") {
        solids.push(makeSolid("weaponCase", (r() < 0.5 ? -1 : 1) * 3.3, z, 30 + d * 18, { weapon: 1 + Math.floor(r() * (level >= 4 ? 4 : 3)) }));
        horde(z - 4, 4 + d, 2, 4); z -= 24;
      } else if (seg === "brutes") {
        for (let i = 0; i < 1 + Math.floor(d / 3); i++) enemies.push(enemy("brute", (r() * 2 - 1) * 3.5, z - i * 3, level));
        horde(z - 2, 4 + d * 2, 4.5, 6); z -= 26;
      }
    }
  }
  if (level >= 3 && !solids.some(o => o.kind === "weaponCase")) { // guarantee a weapon upgrade on the way
    const free = zz => !solids.some(o => Math.abs(o.z - zz) < 5) && !gates.some(g => Math.abs(g.z - zz) < 5);
    let zc = -length * 0.35; while (zc > -length * 0.8 && !free(zc)) zc -= 2;
    solids.push(makeSolid("weaponCase", (rj() < 0.5 ? -1 : 1) * 3.3, zc, 30 + d * 18, { weapon: 2 + Math.floor(rj() * (level >= 4 ? 3 : 2)) }));
  }
  const bossHp = Math.round(40 * Math.pow(level, 1.3) + 40);
  if (!seeded && level > 1) { save.jackDry = jackpots ? 0 : (save.jackDry || 0) + 1; persist(); }
  return { level, theme, length, gates, solids, enemies, expectedKills: enemies.length, boss: { x: 0, z: -length - 14, hp: bossHp, maxHp: bossHp, state: "wait", t: 0, flash: 0, slamT: 0 } };
}

// ---------- squad ----------
function slot(i) { const r = 0.5 * Math.sqrt(i), a = i * 2.39996; return [Math.cos(a) * r, Math.sin(a) * r * 0.85]; }
function squadRadius(n) { return 0.5 * Math.sqrt(Math.max(1, n)) + 0.35; }
function addSoldiers(n) {
  let added = 0;
  for (let i = 0; i < n && L.soldiers.length < 600; i++, added++) {
    const [ox, oz] = slot(L.soldiers.length);
    L.soldiers.push({ x: L.sx + ox * 0.3, z: L.sz + oz * 0.3, ph: Math.random() * 4, born: L.time });
  }
  if (added) bus.emit("soldiersAdded", { n: added, total: L.soldiers.length });
}
function killSoldiers(n, nearX = null, force = false) {
  if (!force && (L.shieldT > 0 || L.giantT > 0)) return; // SHIELD / GIANT power-ups
  for (let k = 0; k < n && L.soldiers.length; k++) {
    let idx = L.soldiers.length - 1;
    if (nearX !== null) { let best = 1e9; L.soldiers.forEach((s, i) => { const d = Math.abs(s.x - nearX); if (d < best) { best = d; idx = i; } }); }
    const s = L.soldiers[idx]; L.fx.push({ x: s.x, y: 0.6, z: s.z, f: 4, t: 0, dur: 0.35, size: 1.1 });
    L.soldiers.splice(idx, 1);
  }
  if (n > 0) bus.emit("soldiersLost", { n, total: L.soldiers.length });
}

// ---------- floating text ----------
function floatText(x, y, z, text, color) {
  tmpV.set(x, y, z).project(camera);
  if (tmpV.z > 1) return;
  const el = document.createElement("div"); el.className = "float stroke"; el.textContent = text; el.style.color = color;
  el.style.left = `${(tmpV.x * 0.5 + 0.5) * 100}%`; el.style.top = `${(-tmpV.y * 0.5 + 0.5) * 100}%`;
  floatsEl.appendChild(el); setTimeout(() => el.remove(), 950);
}

// ---------- game state ----------
let state = "loading"; // loading | home | play | boss | win | lose | paused
let resumeState = "play";
function startLevel(level, opts = {}) {
  floatsEl.innerHTML = "";
  const mod = opts.modifier && MODIFIERS[opts.modifier] ? opts.modifier : null;
  L = generateLevel(level, { ...opts, modifier: mod });
  Object.assign(L, { sx: 0, sz: 0, targetX: 0, soldiers: [], bullets: [], fx: [], fireAcc: 0, weapon: 0, shake: 0, time: 0, shotSfx: 0, boomSfx: 0, popSfx: 0, reached: 0, winT: 0,
    rateMult: mod === "swift" ? 1.25 : 1, speedMul: mod === "swift" ? 1.2 : 1, mode: opts.mode || "normal", modifier: mod, seed: opts.seed, scoreMult: mod ? MODIFIERS[mod].scoreMult : 1,
    score: 0, kills: 0, combo: 0, comboT: 0, bestCombo: 0, surge: 0, surgeT: 0, surges: 0, idleT: 0, shieldT: 0, giantT: 0, giantK: 1,
    bossSoldiers: 0, mult: 1, slowMos: 0, milestone: 0, surgePerKill: 1 / Math.max(12, 0.4 * L.expectedKills) });
  addSoldiers(mod === "lone" ? 1 : START_SQUAD);
  $("levelName").textContent = mod ? MODIFIERS[mod].name : levelName(level); $("levelNo").textContent = L.mode === "daily" ? "Daily Challenge" : `Level ${level}`;
  setWeapon(mod === "arsenal" ? 4 : 0);
  hud.score = 0; hud.best = L.mode === "normal" ? save.bestScore[level] || 0 : 0;
  bus.emit("generate", { L, level, rng: rng((opts.seed ?? level) * 4241 + 7), length: L.length, theme: L.theme, mode: L.mode, modifier: mod });
  bus.emit("levelStart", { level, name: levelName(level), theme: L.theme, mode: L.mode, modifier: mod });
}
// switch level once its theme's art is loaded (shows the loading screen only if that takes a moment)
async function goLevel(level, next, opts = {}) {
  const slow = setTimeout(() => show("loading", true), 200);
  await Scenery.preload(themeFor(level)).catch(e => console.warn("preload failed", e));
  clearTimeout(slow); show("loading", false);
  startLevel(level, opts); setState(next);
}
function goMode(o = {}) { return goLevel(o.level || save.level, o.next || "play", o); } // e.g. {mode: "daily", level, modifier, seed}
const sameRun = () => ({ mode: L.mode, modifier: L.modifier, seed: L.seed });
function setWeapon(i) { L.weapon = i; $("weaponImg").src = WEAPONS[i].img; weaponLabel(); bus.emit("weapon", { index: i, name: WEAPONS[i].name }); }
function weaponLabel() { $("weaponName").textContent = WEAPONS[L.weapon].name + (L.rateMult > 1 ? ` · RATE x${L.rateMult.toFixed(1)}` : ""); }
function show(id, on) { $(id).hidden = !on; }
function setState(s) {
  const from = state; state = s;
  const playing = s === "play" || s === "boss" || s === "bonus";
  show("home", s === "home"); show("progress", playing || s === "paused"); show("pauseBtn", playing); show("settingsBtn", s === "home");
  show("weaponTag", s === "play" || s === "boss"); show("count", playing); show("scoreBox", playing || s === "paused");
  show("levelsBtn", s === "home"); show("levelsModal", s === "levels"); if (s === "levels") renderLevels();
  show("bossbar", s === "boss"); show("winModal", s === "win"); show("loseModal", s === "lose"); show("pauseModal", s === "paused");
  if (from !== s) bus.emit("state", { from, to: s });
}

// ---------- input ----------
let dragging = false, lastX = 0;
gameEl.addEventListener("pointerdown", e => {
  if (e.target.closest("button,.panel")) return;
  if (state === "home") { setState("play"); sfx("gate"); }
  if (state !== "play" && state !== "boss") return;
  dragging = true; lastX = e.clientX; gameEl.setPointerCapture?.(e.pointerId);
});
gameEl.addEventListener("pointermove", e => {
  if (!dragging || !L) return;
  const dx = (e.clientX - lastX) / gameEl.clientWidth; lastX = e.clientX;
  L.targetX += dx * ROAD * 2.6;
});
addEventListener("pointerup", () => dragging = false);
addEventListener("pointercancel", () => dragging = false);
const keys = {};
addEventListener("keydown", e => {
  keys[e.key] = true;
  if (state === "home" && ["ArrowLeft", "ArrowRight", "a", "d", " ", "Enter"].includes(e.key)) setState("play");
  if (state === "levels" && e.key === "Escape") { setState("home"); return; }
  if (e.key === "Escape" || e.key === "p") togglePause();
});
addEventListener("keyup", e => keys[e.key] = false);
function togglePause() {
  if (state === "play" || state === "boss" || state === "bonus") { resumeState = state; setState("paused"); }
  else if (state === "paused") setState(resumeState);
}
$("pauseBtn").onclick = togglePause; $("settingsBtn").onclick = () => { resumeState = "home"; setState("paused"); };
$("playBtn").onclick = () => { if (state === "home") { setState("play"); sfx("gate"); } };
$("levelsBtn").onclick = () => setState("levels"); $("levelsClose").onclick = () => setState("home");
$("resumeBtn").onclick = () => setState(resumeState);
$("quitBtn").onclick = () => goLevel(L.level, "home", sameRun());
$("nextBtn").onclick = () => goLevel(save.level, "home");
$("retryBtn").onclick = () => goLevel(L.level, "play", sameRun());
function syncToggles() {
  for (const [id, k] of [["soundBtn", "sound"], ["vibeBtn", "vibe"]]) { $(id).setAttribute("aria-pressed", save[k]); $(id).textContent = save[k] ? "ON" : "OFF"; }
}
$("soundBtn").onclick = () => { save.sound = !save.sound; persist(); syncToggles(); };
$("vibeBtn").onclick = () => { save.vibe = !save.vibe; persist(); syncToggles(); };
document.addEventListener("visibilitychange", () => { if (document.hidden && (state === "play" || state === "boss" || state === "bonus")) togglePause(); });

// ---------- simulation ----------
const ENEMY_ASPECT = { zombie: 0.861, grunt: 0.787, brute: 0.946 };
function fireRate() { return (1 / 0.3) * WEAPONS[L.weapon].rate * L.rateMult; }
function damage() { return WEAPONS[L.weapon].dmg * (L.surgeT > 0 ? 2 : 1); } // SURGE: double damage (and pierce), same bullet count

// ---------- time feel: hit-stop and slow motion (sim only; UI and camera shake keep real time) ----------
const time = { scale: 1, target: 1, slowT: 0, stopT: 0, lastSlow: -99, lastStop: -99 };
function slowMo(scale, seconds, force = false) {
  const now = performance.now() / 1000;
  if (!force && (now - time.lastSlow < 4 || (L && L.slowMos >= 3))) return; // rare peaks only
  time.lastSlow = now; time.slowT = seconds; time.target = scale; if (L) L.slowMos++;
}
function hitStop(seconds) {
  const now = performance.now() / 1000;
  if (now - time.lastStop < 0.4) return;
  time.lastStop = now; time.stopT = Math.max(time.stopT, seconds);
}
function timeScale(realDt) {
  if (time.stopT > 0) { time.stopT -= realDt; return 0; }
  if (time.slowT > 0) { time.slowT -= realDt; time.scale += (time.target - time.scale) * Math.min(1, realDt * 20); }
  else time.scale += (1 - time.scale) * Math.min(1, realDt * 6);
  return time.scale;
}

// ---------- score, combo, SURGE ----------
const hud = { score: 0, best: 0 }, rainbowColor = new THREE.Color();
function comboTier() { for (const t of COMBO_TIERS) if (L.combo >= t[0]) return t; return null; }
function addScore(points, o = {}) {
  const t = o.raw ? null : comboTier();
  const pts = Math.round(points * (t ? t[1] : 1) * (L.scoreMult || 1));
  if (pts <= 0) return 0;
  L.score += pts;
  bus.emit("score", { delta: pts, total: L.score, reason: o.reason || "", x: o.x, z: o.z });
  return pts;
}
function fillSurge(amount) {
  if (L.surgeT > 0 || L.surges >= SURGES_PER_LEVEL) return;
  L.surge = Math.min(1, L.surge + amount);
  if (L.surge >= 1) { L.surgeT = SURGE_TIME; L.surges++; bus.emit("surge", { on: true }); sfx("win"); vibe(60); floatText(L.sx, 3.2, L.sz, "SURGE!", "#ffd84a"); }
}
function breakCombo() { if (L.combo >= 5) bus.emit("comboEnd", { count: L.combo }); L.combo = 0; L.comboT = 0; }
function onKill(e) {
  L.kills++; L.idleT = 0;
  L.combo = L.comboT > 0 ? L.combo + 1 : 1; L.comboT = COMBO_WINDOW; L.bestCombo = Math.max(L.bestCombo, L.combo);
  for (const t of COMBO_TIERS) if (L.combo === t[0]) bus.emit("combo", { count: L.combo, tier: COMBO_TIERS.length - COMBO_TIERS.indexOf(t), name: t[2], mult: t[1] });
  const pts = addScore(e.type === "brute" ? POINTS.brute : POINTS.kill, { x: e.x, z: e.z, reason: "kill" });
  fillSurge(L.surgePerKill);
  if (L.popSfx <= 0) { const tier = comboTier(); sfx("pop", Math.pow(2, (tier ? COMBO_TIERS.length - COMBO_TIERS.indexOf(tier) : 0) * 2 / 12)); L.popSfx = 0.07; }
  bus.emit("kill", { e, points: pts, combo: L.combo });
}
function setShield(sec) { const was = L.shieldT > 0; L.shieldT = Math.max(0, sec); if (was !== L.shieldT > 0) bus.emit("shield", { on: L.shieldT > 0 }); }
function setGiant(sec) { const was = L.giantT > 0; L.giantT = Math.max(0, sec); if (was !== L.giantT > 0) bus.emit("giant", { on: L.giantT > 0 }); }
function spawnSolid(kind, x, z, hp, extra = {}) { const o = makeSolid(kind, x, z, hp, extra); L.solids.push(o); return o; }
function damageArea(x, z, radius, dmg) { // explosions from modules (barrels, airstrikes): enemies, solids and the boss
  for (const e of L.enemies) if (e.hp > 0 && e.state !== "dead" && e.state !== "dying" && Math.hypot(e.x - x, e.z - z) < radius + e.r) hitEnemy(e, dmg);
  for (const o of L.solids) if (o.alive && Math.hypot(o.x - x, o.z - z) < radius + o.hw) hitSolid(o, dmg);
  const b = L.boss; if (state === "boss" && b.hp > 0 && Math.hypot(b.x - x, b.z - z) < radius + 2.6) { b.hp -= dmg; b.flash = 0.08; if (b.hp <= 0) bossDown(); }
  bus.emit("explosion", { x, z, radius });
}
function finishLevel(mult) { L.mult = Math.max(1, mult || 1); win(); } // called by js/finale.js
function endBoss() { // after the boss falls: hand over to the finale if there is one
  if (window.Finale && Finale.start && Finale.start(ctx)) { L.bonusT = 0; setState("bonus"); bus.emit("bonusState", {}); }
  else win();
}
function bonusStep(dt) { // finale: js/finale.js moves the squad and breaks walls; the game keeps formation and effects running
  L.soldiers.forEach((s, i) => { const [ox, oz] = slot(i); s.x += (L.sx + ox - s.x) * Math.min(1, dt * 10); s.z += (L.sz + oz - s.z) * Math.min(1, dt * 10); s.x = Math.max(-ROAD + 0.3, Math.min(ROAD - 0.3, s.x)); });
  for (let i = L.fx.length - 1; i >= 0; i--) { const f = L.fx[i]; f.t += dt; if (f.t >= f.dur) L.fx.splice(i, 1); }
  L.shake = Math.max(0, L.shake - dt);
  $("countN").textContent = L.soldiers.length;
