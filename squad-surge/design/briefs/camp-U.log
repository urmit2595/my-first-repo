/* ---------------- panels ---------------- */
addEventListener("keydown", e => {
  keys[e.key] = true;
  if ((state === "play" || state === "boss") && !e.repeat) {
    const k = e.key.toLowerCase();
    if (k === "1" || k === "q") { e.preventDefault(); usePowerup(0); }
    if (k === "2" || k === "e") { e.preventDefault(); usePowerup(1); }
    if (e.code === "Space") { e.preventDefault(); useSurge(); }
  }
  if (state === "home" && ["ArrowLeft", "ArrowRight", "a", "d", " ", "Enter"].includes(e.key)) setState("play");
  if (state === "levels" && e.key === "Escape") { setState("home"); return; }
  if (e.key === "Escape" || e.key === "p") togglePause();
});
addEventListener("keyup", e => keys[e.key] = false);
function togglePause() {
  if (state === "play" || state === "boss" || state === "bonus") { resumeState = state; setState("paused"); }
  else if (state === "paused") setState(resumeState);

