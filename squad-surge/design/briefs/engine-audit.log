   234	  // ------------------------------------------------------------------ setup
   235	  function setup(ctx) {
   236	    C = ctx; T = ctx.THREE;
   237	    const { renderer, scene } = C;
   238	    renderer.outputEncoding = T.sRGBEncoding; renderer.toneMapping = T.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.05;
   239	    renderer.shadowMap.enabled = true; renderer.shadowMap.type = T.PCFSoftShadowMap;
   240	    S.hemi = new T.HemisphereLight(0xffffff, 0x888888, 0.8); scene.add(S.hemi);
   241	    const sun = S.sun = new T.DirectionalLight(0xffffff, 1.5); sun.castShadow = true;
   242	    sun.shadow.mapSize.set(1024, 1024); const sc = sun.shadow.camera; sc.left = -26; sc.right = 26; sc.top = 30; sc.bottom = -30; sc.near = 1; sc.far = 160;
