   327	  function gateHalf(g, h, good, text) {
   328	    const hs = h.vis; if (!hs) return;
   329	    const pal = h.jackpot ? GOLD : good ? GOOD : BAD; good = h.jackpot ? "gold" : good;
   330	    if (hs.good === undefined) { for (const k in pal) hs.cur[k].copy(pal[k]); hs.dst = pal; hs.bt = 1; paintHalf(hs); }
   331	    else if (hs.good !== good) { hs.src = { panel: hs.cur.panel.clone(), edge: hs.cur.edge.clone(), glow: hs.cur.glow.clone() }; hs.dst = pal; hs.bt = 0; hs.flash = 1; }
   332	    hs.good = good;
   333	    if (hs.text !== text) { if (hs.text !== undefined) hs.pulse = 1; hs.text = text; C.drawLabel(hs.L.lab, text, h.jackpot ? "#fff3b8" : "#ffffff", 0.74); }
