   247	    S.skyMat = new T.ShaderMaterial({
   248	      uniforms: { top: { value: new T.Color() }, bot: { value: new T.Color() }, sunDir: { value: new T.Vector3(0, 0, -1) }, sunCol: { value: new T.Color() } },
   249	      vertexShader: "varying vec3 vD; void main(){ vD = position; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }",
   250	      fragmentShader: "uniform vec3 top; uniform vec3 bot; uniform vec3 sunDir; uniform vec3 sunCol; varying vec3 vD; void main(){ vec3 d = normalize(vD); float t = smoothstep(-0.02, 0.55, d.y); vec3 c = mix(bot, top, t); float s = max(dot(d, normalize(sunDir)), 0.0); c += sunCol * (pow(s, 6.0) * 0.35 + pow(s, 60.0) * 0.5); gl_FragColor = vec4(c, 1.0); }",
   251	      side: T.BackSide, depthWrite: false, depthTest: false, fog: false });
   252	    S.sky = new T.Mesh(new T.SphereBufferGeometry(350, 24, 12), S.skyMat); S.sky.frustumCulled = false; S.sky.renderOrder = -10; scene.add(S.sky);
   253	    // backdrop: far plane showing the theme's panorama; the image row `horizon` sits on the camera's horizon
   254	    S.backMat = new T.ShaderMaterial({
   255	      uniforms: { map: { value: null }, planeSize: { value: new T.Vector2(1, 1) }, imgSize: { value: new T.Vector2(1, 1) }, hz: { value: 0.5 }, fogCol: { value: new T.Color() }, uOff: { value: 0 }, tint: { value: new T.Color(1, 1, 1) } },
