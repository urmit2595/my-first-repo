   275	  // ------------------------------------------------------------------ water
   276	  function makeWater(cfg, w, d) {
   277	    const wc = cfg.water;
   278	    const m = new T.ShaderMaterial({
   279	      uniforms: T.UniformsUtils.merge([T.UniformsLib.fog, { time: { value: 0 }, deep: { value: new T.Color(wc.deep) }, shallow: { value: new T.Vector3(...wc.shallow) }, sunDir: { value: new T.Vector3(...cfg.sunPos).normalize() }, skyCol: { value: new T.Color(cfg.env[0]) } }]),
