h.floor(L.soldiers.length / Math.max(1, L.peakSquad) * 100), squad: L.bossSoldiers || L.soldiers.length, peakSquad: L.peakSquad, threats: L.threats.map(t => ({ kind: t.kind, start: t.startSquad, cap: t.lossCap, lost: t.lost, countered: t.countered })), tactics: { ...H.ctx.tactics }, events: sandbox.__tacticsCounts, errors };\\n      results.push(row); console.log(JSON.stringify(row));\\n    }\\n  } else {\\n  await new Promise((resolve, reject) => { server.once(\"error\", reject); server.listen(0, \"127.0.0.1\", resolve); });')
