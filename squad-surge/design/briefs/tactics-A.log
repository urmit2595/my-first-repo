    const hit = L.soldiers.filter(s => Math.abs(s.x - o.x) < o.hw + 0.2).length;
    if (!hit) continue;
    const guarded = L.shieldT > 0 || L.giantT > 0, lose = guarded ? 0 : Math.min(hit, Math.ceil(o.hp / 10) + 1);
    if (lose) { killSoldiers(lose, o.x); breakCombo(); vibe(50); flashRed(); floatText(o.x, 2, o.z, `-${lose}`, "#ff6a5a"); }
