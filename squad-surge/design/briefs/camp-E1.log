      addSoldiers(gain); sfx("gate"); floatText(L.sx, 2, L.sz, h.op === "x" ? `x${h.v}` : `+${gain}`, h.jackpot ? "#ffd84a" : "#7fd0ff");
      addScore(gain * POINTS.soldier, { raw: true, x: L.sx, z: L.sz, reason: "gate" }); fillSurge(Math.min(0.15, gain / 200));
