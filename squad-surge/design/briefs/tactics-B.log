function skinFilter(it) {
  if (it.hue != null) return `hue-rotate(${Math.round(it.hue * 360 - 217)}deg) saturate(${(0.5 + it.sat * 0.9).toFixed(2)}) brightness(${(it.val || 1).toFixed(2)})`;
  if (it.i === 0) return "none";
