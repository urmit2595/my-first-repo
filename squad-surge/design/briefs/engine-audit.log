   594	          const t = k / 16, z = za + (zb - za) * t, y = 5 + (topY - 5) * Math.pow(2 * t - 1, 2), p = [x, y, z];
   595	          if (prev) cb.beam(prev, p, 0.24, red, fix); prev = p;
   596	          if (k > 0 && k < 16 && k % 1 === 0) cb.beam([x, y, z], [x, 1.1, z], 0.07, lin(0xe8e2d8), fix);
   597	        }
   598	      }
   599	    }
   600	    for (const s of [-1, 1]) { // guard rail: posts and two rails
   601	      const x = s * 10.75;
   602	      for (let z = Z0; z > Z1; z -= 3) rl.box(x - 0.1, x + 0.1, 0.2, 1.1, z - 0.1, z + 0.1, lin(0xe9edf2), { fix });
   603	      for (const y of [0.55, 1.0]) rl.box(x - 0.07, x + 0.07, y, y + 0.12, Z1, Z0, lin(0xdfe6ee), { fix });
   604	      rl.box(x - 0.22, x + 0.22, 0.2, 0.42, Z1, Z0, lin(0xa8b3c2), { fix });
   605	    }
