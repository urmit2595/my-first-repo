   642	      list.push({ it, x, y: y - sink * h, z, w, h, flip });
   643	      if (ground) blobs.push({ x: x + h * 0.14 + w * 0.05, y: y + 0.03, z: z + h * 0.08, l: Math.max(w * 0.8, h * 0.5), wd: Math.max(w * 0.4, 0.5) });
   644	    };
   645	    const useBuildings = !!cfg.rows && cfg.rows !== "desert" && cfg.rows !== "pier";
   646	    const tall = [];
   647	    if (cfg.rhythm && by.curb) for (let z = Z0 - 4; z > Z1 + 10; z -= cfg.rhythm) { const it = pick(by.curb); for (const side of [-1, 1]) add(it, side * 7.6, 0.2, z, true, 0, 1, side < 0 ? 0 : 1); }
   648	    for (const side of [-1, 1]) {
   649	      if (by.curb && !cfg.rhythm) for (let z = Z0 - rr(0, 10); z > Z1 + 10; z -= rr(cfg.curb[0], cfg.curb[1])) {
   650	        const it = pick(by.curb); if (blocked(side, z, 1.5)) continue;
   651	        if (it.h >= 3) { if (tall.some(t => t.name === it.name && Math.abs(t.z - z) < 8)) continue; tall.push({ name: it.name, z }); }
