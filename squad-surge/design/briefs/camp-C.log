+      solid(174, "weaponCase", 3.4, 56, { weapon: 1 }),
+      wave(212, "charger", 4, -1, "line", 12), wave(258, "grunt", 30, 0)
+    ]);
+  mission(3, 2, "Short Fuse", 310, 30, "noWaste",
