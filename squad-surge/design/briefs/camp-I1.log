function lose() {
  const pct = Math.floor(L.reached * 100);
  const prev = save.best[L.level] || 0; if (!L.mission) { save.best[L.level] = Math.max(prev, L.reached); persist(); }
  $("losePct").textContent = state === "boss" ? "BOSS" : `${pct}%`;
  $("loseBest").textContent = prev && prev < 1 ? `Best: ${Math.floor(prev * 100)}%` : "";
  const atBoss = state === "boss", bossPct = atBoss ? Math.max(1, Math.round(L.boss.hp / L.boss.maxHp * 100)) : null;
  if (atBoss) $("losePct").textContent = `BOSS ${bossPct}%`;
