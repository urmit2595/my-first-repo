   284	  // number on a dark pill (or plain), white with navy stroke; redrawn on demand (e.g. after the web font loads)
   285	  function drawNum(lab, text, color, pill, force) {
   286	    const key = text + "|" + color; if (!force && lab.last === key) return; lab.last = key;
   287	    const g = lab.ctx, c = lab.c; g.clearRect(0, 0, c.width, c.height);
   288	    g.font = `${Math.round(c.height * 0.74)}px 'Lilita One', sans-serif`; g.textAlign = "center"; g.textBaseline = "middle"; g.lineJoin = "round";
   289	    if (pill) { const w = Math.min(c.width - 6, g.measureText(text).width + c.height * 0.55), h = c.height * 0.88; g.fillStyle = "rgba(10,18,44,.82)"; rrect(g, (c.width - w) / 2, (c.height - h) / 2, w, h, h / 2); g.fill(); }
   290	    g.lineWidth = c.height * 0.13; g.strokeStyle = "#0d1630"; g.strokeText(text, c.width / 2, c.height * 0.54); g.fillStyle = color; g.fillText(text, c.width / 2, c.height * 0.54);
   291	    lab.tex.needsUpdate = true;
   292	  }
