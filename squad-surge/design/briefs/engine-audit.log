   607	  }
   608	  function pierExtras(rnd, Z0, Z1, tex) {
   609	    const { world } = C, b = new Batch(), fix = [0.5, 0.5], wood = lin(0x6e4c30), woodD = lin(0x3b2a1c), rope = lin(0xd9c79a);
   610	    for (const s of [-1, 1]) {
