function makeThreat(kind,z,id){return {id,kind,counter:THREAT_COUNTER[kind],z,announced:false,live:false,done:false,countered:false,lost:0,actors:[],age:0,shotT:0,shellT:0,gap:gameplayRng("layout")<.5?-1:1};}
async function goMission(id,{assist=0,elite=false}={}) {
  const m=window.Campaign?.missions?.[id];if(!m)return false;
  await goLevel((m.chapter-1)*6+m.n,"play",{mission:m,mode:"campaign",seed:m.seed,assist,elite});return true;
}
function goArcade(level=1){return goLevel(level,"play",{mode:"normal"});}
function restartSame(){return L?.mission?goMission(L.mission.id,{elite:L.elite}):goLevel(L.level,"play",sameRun());}
function skillOk() {
  if(!L.mission)return false;const m=L.missionState;
  const skills={noWaste:L.tactics.wasted===0,rescueAll:m.rescueTaken===m.rescueTotal,perfect2:L.tactics.perfect>=2,medicsFirst:m.medicsFirst,noCharge:!(m.causes.charger>0),bossClean:m.bossLosses<20,fast:m.rescueSlowdowns===0,noAssist:!m.assisted};
  return !m.assisted && skills[L.mission.skill?.id]===true;
}
function missionStars(won,keptPct){return [won,won&&keptPct>=65,won&&skillOk()];}
function endMission(result,keptPct){
  if(L.missionEnded)return;L.missionEnded=true;
  const p=missionProgress(L.mission.id),won=result==="win",stars=missionStars(won,keptPct),m=L.missionState;
  p.bestStars=Math.max(p.bestStars,stars.filter(Boolean).length);p.consecutiveFails=won?0:p.consecutiveFails+1;p.assistedWin=!!(p.assistedWin||(won&&m.assisted));p.lastCause=won?null:L.lastCause;(save.campaign.stars ||= {})[L.mission.id]=p.bestStars;persist();
  bus.emit("missionEnd",{id:L.mission.id,result,stars,keptPct,skillOk:skillOk(),cause:won?null:L.lastCause,rescued:m.rescued,assisted:m.assisted});
  if(!won&&(p.consecutiveFails===2||p.consecutiveFails===4))bus.emit("assistOffer",{id:L.mission.id,level:p.consecutiveFails===4?2:1});
}
function updateCampaign(dt) {
  if(!L.mission)return;
  for(const r of L.radios)if(!r.fired&&-L.sz>=r.at){r.fired=true;bus.emit("radio",{who:r.who,text:r.text});}
  for(const g of L.gates)if(g.moving&&!g.used){g.offset=Math.sin(L.time*1.2)*1.25;for(const h of g.halves)h.x=h.baseX+g.offset;Obj3D.moveGate?.(g);}
  for(const h of L.hazards){
    if(h.done)continue;const ahead=L.sz-h.z;
    if(!h.warned&&ahead<32+squadRadius(L.soldiers.length)){h.warned=true;h.age=-dt;bus.emit("enemyTelegraph",{type:"hazard",kind:h.kind,x:h.x,z:h.z,lane:h.lane});}
    if(!h.warned)continue;h.age+=dt;
    const phase=h.age%h.period;h.active=h.age>=.9&&(h.kind==="collapse"||phase>=.9&&phase<1.7);
    if(h.kind==="saw")h.x=h.lane*3.4+Math.sin(h.age*2)*.7;
    Obj3D.updateHazard?.(h);
    if(h.active&&!h.wasActive)bus.emit("hazard",{kind:h.kind,lane:h.lane});h.wasActive=h.active;
    if(h.active)killSoldiersInRect(h.x-1.35,h.x+1.35,h.z-1.6,h.z+1.6,Infinity,"threat:"+h.kind);
    if(ahead < -squadRadius(L.soldiers.length)-4){h.done=true;if(h.vis)h.vis.visible=false;}
  }
}
