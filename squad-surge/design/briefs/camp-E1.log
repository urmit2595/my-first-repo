    const onFront = o.kind === "blockBlue" || o.kind === "blockYellow" || o.kind === "crate";
    v.pill = !!s.pill; v.L = newLabel(256, 128, s.w, 5); v.L.mesh.position.set(0, s.y, onFront ? 0.08 : 0.1); if (!onFront) v.L.mesh.renderOrder = 6; root.add(v.L.mesh);
