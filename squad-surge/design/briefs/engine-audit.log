   375	        const xi = s * ROAD, xc = s * (ROAD + 0.08), xo = s * (ROAD + 0.62), yt = 0.3, yc = 0.23;
   376	        const side = (xa, ya, xb, yb, h) => b.quad([[xa, ya, Z0], [xa, ya, Z1], [xb, yb, Z1], [xb, yb, Z0]], [cuv(Z0, 0), cuv(Z1, 0), cuv(Z1, 1), cuv(Z0, 1)], white, h);
