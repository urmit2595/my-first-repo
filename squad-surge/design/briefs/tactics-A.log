  cEl.hidden = L.combo < 5;
  if (!cEl.hidden) { cEl.textContent = `x${L.combo}`; cEl.className = "combo stroke" + (tier ? ` t${COMBO_TIERS.length - COMBO_TIERS.indexOf(tier)}` : ""); }
  $("surgeFill").style.width = `${Math.round(L.surge * 100)}%`; $("count").classList.toggle("surging", L.surgeT > 0);
  // squad count badge above the squad
  if (!$("count").hidden) {
    tmpV.set(L.sx, (1.95 + R * 0.3) * L.giantK, L.sz).project(camera);
    const c = $("count"); c.style.left = `${(tmpV.x * 0.5 + 0.5) * 100}%`; c.style.top = `${(-tmpV.y * 0.5 + 0.5) * 100}%`;
  }
}

let last = performance.now();
function frame(now) {
  const rawDt = (now - last) / 1000, dt = Math.min(0.05, rawDt); last = now;
  if (L) {
    adaptQuality(Math.min(rawDt, 0.25));
    hud.realDt = state === "paused" ? 0 : dt;
    const sim = state === "play" || state === "boss" || state === "bonus", gdt = sim ? dt * timeScale(dt) : dt;
    if (sim) { if (gdt > 0) step(gdt); }
    else if (state === "home") L.time += dt;
    render(state === "paused" ? 0 : gdt);
  }
  requestAnimationFrame(frame);
}

// ---------- boot ----------
(async function boot() {
  try {
    await Promise.all([
      loadTex("soldier", "assets/soldier.webp"), loadTex("zombie", "assets/zombie.webp"), loadTex("grunt", "assets/grunt.webp"),
      loadTex("brute", "assets/brute.webp"), loadTex("boss", "assets/boss.webp"), loadTex("fx", "assets/fx.jpg"),
      document.fonts ? document.fonts.load("40px 'Lilita One'").catch(() => null) : null,
    ]);
  } catch (err) {
    $("loadErr").textContent = `${err.message}. Check your connection and reload.`; console.error(err); return;
  }
  layers = {
    shadow: new ShadowLayer(1500),
    sold: new SpriteLayer(TEX.soldier, 4, 2, 700),
    enem: null, brute: new SpriteLayer(TEX.brute, 4, 2, 80),
    boss: new SpriteLayer(TEX.boss, 3, 2, 1),
    fx: new SpriteLayer(TEX.fx, 4, 4, 1400, { additive: true }),
  };
  const enemyLayers = { zombie: new SpriteLayer(TEX.zombie, 4, 2, 900), grunt: new SpriteLayer(TEX.grunt, 4, 2, 900) };
  Object.defineProperty(layers, "enem", { get: () => { const k = L.theme.enemy; const other = k === "zombie" ? "grunt" : "zombie"; enemyLayers[other].begin(); enemyLayers[other].end(); return enemyLayers[k]; } });
  resize(); syncToggles();
  Scenery.setup(ctx); Obj3D.setup(ctx); Juice.setup(ctx);
  for (const m of [window.Powerups, window.Finale, window.Meta]) { try { m?.setup?.(ctx); } catch (e) { console.error("module setup failed", e); } }
  applySkin();
  if (!quality.auto) quality.level = 2; // ?hq: full quality for screenshots and tests
  applyQuality();
  await Scenery.preload(themeFor(save.level)).catch(e => console.warn("preload failed", e));
  startLevel(save.level); setState("home");
  $("loading").hidden = true;
  requestAnimationFrame(frame);
})();
// test hooks (read by the headless playtest bot)
window.__game = { get L() { return L; }, get state() { return state; }, setState, startLevel, goLevel, save, bus, ctx, cam: CAM, quality };
</script>

