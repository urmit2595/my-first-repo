   311	  function clearWorld() {
   312	    const { world } = C;
   313	    const geos = new Set(), mats = new Set();
   314	    world.traverse(o => { if (o.geometry) geos.add(o.geometry); if (o.material) (Array.isArray(o.material) ? o.material : [o.material]).forEach(m => mats.add(m)); });
