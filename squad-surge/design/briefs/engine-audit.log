   630	  // ------------------------------------------------------------------ props (one instanced mesh per atlas)
   631	  function buildProps(cfg, K, rnd, occ, Z0, Z1, waterY) {
   632	    const { world } = C, items = K.items.filter(i => (i.weight ?? 1) > 0), aw = K.atlasImg.width, ah = K.atlasImg.height;
   633	    const rr = (a, b) => a + rnd() * (b - a);
   634	    const zoneOf = it => (it.zone === "lot" && cfg.remapLot ? "walk" : it.zone);
   635	    const by = {}; for (const it of items) (by[zoneOf(it)] ||= []).push(it);
   636	    const pick = list => { let t = 0; for (const i of list) t += i.weight ?? 1; let q = rnd() * t; for (const i of list) { q -= i.weight ?? 1; if (q <= 0) return i; } return list[0]; };
   637	    const list = [], blobs = [];
   638	    const blocked = (side, z, w) => occ.some(o => o.side === side && o.kind !== "lot" && o.kind !== "alley" && z < o.z0 + w / 2 && z > o.z1 - w / 2);
   639	    const inGap = (side, z) => occ.some(o => o.side === side && (o.kind === "lot" || o.kind === "alley") && z <= o.z0 && z >= o.z1);
   640	    const add = (it, x, y, z, ground = true, sink = 0, k = 1, fl = -1) => {
