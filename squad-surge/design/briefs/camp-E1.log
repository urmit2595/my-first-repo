  L.surgeReady = false; L.surgeT = SURGE_TIME; L.surges++;
  const perfect = !!L.threat || state === "boss";
  L.tactics.used++;
  if (perfect) { L.tactics.surgePerfect++; rewardPerfect("surge", false); }
  bus.emit("powerupUse", { type: "surge", slot: null, perfect, misused: false, wasted: false, threatKind: L.threat ? L.threat.kind : null });
  bus.emit("surge", { on: true, perfect });
  sfx("win"); vibe(60); updateBeltHUD(); return true;
}
function breakCombo() { if (L.combo >= 5) bus.emit("comboEnd", { count: L.combo }); L.combo = 0; L.comboT = 0; }
function onKill(e) {
  L.kills++; L.idleT = 0;
  L.combo = L.comboT > 0 ? L.combo + 1 : 1; L.comboT = COMBO_WINDOW; L.bestCombo = Math.max(L.bestCombo, L.combo);
  for (const t of COMBO_TIERS) if (L.combo === t[0]) bus.emit("combo", { count: L.combo, tier: COMBO_TIERS.length - COMBO_TIERS.indexOf(t), name: t[2], mult: t[1] });
