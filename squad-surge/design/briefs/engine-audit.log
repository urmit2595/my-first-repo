   260	  }
   261	
   262	  function makeEnv(cfg) {
   263	    const e = cfg.env, sc = new T.Scene();
   264	    const m = new T.ShaderMaterial({
   265	      uniforms: { top: { value: lin(e[0]) }, mid: { value: lin(e[1]) }, bot: { value: lin(e[2]) }, sun: { value: lin(e[3]) }, sd: { value: new T.Vector3(...cfg.sunPos).normalize() } },
   266	      vertexShader: "varying vec3 vD; void main(){ vD = position; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }",
