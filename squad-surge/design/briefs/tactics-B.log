  run.done.push({ text: mtext(m), medals: e.m, ic: e.ic });
  toast(`${ico("medal")}<span><b>MISSION COMPLETE</b><small>${mtext(m)} · +${e.m} medal${e.m > 1 ? "s" : ""}</small></span>`, "ms");
  M.missions[i] = drawMission(false);
