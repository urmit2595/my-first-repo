const fs=require('fs'),vm=require('vm');const c={window:{}};vm.runInNewContext(fs.readFileSync('js/campaign.js','utf8'),c);for(const ch of c.window.Campaign.chapters){console.log(ch.name);for(const id of ch.missions){const m=c.window.Campaign.missions[id];const weights={grunt:1,zombie:1,brute:11,shieldbearer:4,charger:3,bomber:3,rifleman:4,medic:5,splitter:8};let count=0,budget=0,max=m.start;for(const e of m.events){if(e.event==='wave'){count+=e.count;budget+=e.count*weights[e.type];}if(e.event==='threat')budget+=({swarm:40,mortars:24,barricade:16})[e.kind];if(e.event==='gate'){const calc=h=>Array.isArray(h)?h[0]==='+'?max+h[1]:h[0]==='-'?max-h[1]:max*h[1]:h.recruit?max+h.n:h.rescue?max-h.cost:max+8;max=Math.max(calc(e.left),calc(e.right));}if(e.event==='solid')max+=e.reward||0;if(e.event==='drop')max+=e.pair?16:8;}budget+=(m.boss?.hp||0)/10;console.log(id,'count',count,'budget',budget,'max squad',max);}}
