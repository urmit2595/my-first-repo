    return `Save ${tool === "AIRSTRIKE" ? "an" : "a"} ${tool} for the ${missed.kind === "swarm" ? "swarm before the boss" : missed.kind === "barricade" ? "barricade" : missed.kind === "mortars" ? "mortars" : "boss slam"}.`;
