    for (let i = 0; i < 8; i++) { const m = new THREE.Mesh(bombGeo, bombMat); m.visible = false; m.frustumCulled = false; root.add(m); S.bombs.push(m); }
  }
  function ring(x, z, r0, r1, life, color, additive, op) {
