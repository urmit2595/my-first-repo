function hitEnemy(e, dmg) {
  e.hp -= dmg; e.flash = 0.07; bus.emit("enemyHit", { e });
  if (e.hp <= 0) {
    e.state = "dying"; e.dieT = 0; bus.emit("enemyDie", { e }); onKill(e);
    if (e.type === "brute") { L.fx.push({ x: e.x, y: 0.5, z: e.z, f: 9, t: 0, dur: 0.45, size: 3 }); L.shake = 0.2; sfx("boom"); }
    else if (Math.random() < 0.3) L.fx.push({ x: e.x, y: 0.9, z: e.z, f: 6, t: 0, dur: 0.3, size: 1 });
  }
}
function damageBoss(n) {
