// ---------- score, combo, SURGE ----------
const hud = { score: 0, best: 0 }, rainbowColor = new THREE.Color();
function comboTier() { for (const t of COMBO_TIERS) if (L.combo >= t[0]) return t; return null; }
function addScore(points, o = {}) {
  const t = o.raw ? null : comboTier();
  const pts = Math.round(points * (t ? t[1] : 1) * (L.scoreMult || 1));
  if (pts <= 0) return 0;
  L.score += pts;
  bus.emit("score", { delta: pts, total: L.score, reason: o.reason || "", x: o.x, z: o.z });
  return pts;
}
function fillSurge(amount) {
