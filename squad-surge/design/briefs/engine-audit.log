   355	    } else {
   356	      const gt = tex("ground", "ground", cfg.ground), gTile = tile("ground", 10), b = new Batch();
   357	      const x0 = -170, x1 = 170;
   358	      b.quad([[x0, -0.03, Z0], [x1, -0.03, Z0], [x1, -0.03, Z1], [x0, -0.03, Z1]], [[x0 / gTile, Z0 / gTile], [x1 / gTile, Z0 / gTile], [x1 / gTile, Z1 / gTile], [x0 / gTile, Z1 / gTile]], white, [0, 1, 0]);
   359	      const m = new T.Mesh(b.geometry(), L({ map: gt, vertexColors: true, color: id === "ruins" ? lin(0xcfc4b8) : new T.Color(1, 1, 1).multiplyScalar(cfg.dim || 1) })); m.receiveShadow = true; world.add(m);
   360	    }
   361	
