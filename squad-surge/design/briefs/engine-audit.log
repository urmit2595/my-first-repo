   581	        const x = s * 11.8;
   582	        tw.box(x - 0.9, x + 0.9, 0, towerH, z - 1, z + 1, red, { bot: redD, fix, top: lin(0xf06a4a) });
   583	        tw.box(x - 1.15, x + 1.15, 0, 1.4, z - 1.25, z + 1.25, redD, { fix });
   584	      }
   585	      for (const y of [25.5, 30]) tw.box(-11.8, 11.8, y, y + 1.3, z - 0.8, z + 0.8, red, { fix, bot: redD });
   586	      for (const s of [-1, 1]) tw.box(s * 11.8 - 1.1, s * 11.8 + 1.1, towerH, towerH + 0.6, z - 1.2, z + 1.2, redD, { fix });
   587	    }
   588	    // cables and hangers between consecutive towers
   589	    for (let i = 0; i + 1 < zs.length; i++) {
