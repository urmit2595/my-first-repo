function win() {
  if (state !== "boss" && state !== "bonus" && !(L.mission && state === "play")) return;
  const n = L.bossSoldiers || L.soldiers.length, kept = Math.min(1, n / Math.max(1, L.peakSquad));
  const keptPct = Math.floor(kept * 100), stars = L.mission ? missionStars(true, keptPct).filter(Boolean).length : n >= 30 + L.level * 10 && kept >= 0.65 ? 3 : n >= 10 + L.level * 3 && kept >= 0.35 ? 2 : 1;
