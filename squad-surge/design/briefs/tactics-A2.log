function themeFor(level) { return THEMES[(level - 1) % THEMES.length]; }

// ---------- tactics: belt, learning, encounter lifecycle ----------
const THREAT_COUNTER = { swarm: "airstrike", barricade: "giant", mortars: "shield", slam: "shield" };
function updateBeltHUD() {
  if (!L || !L.belt) return;
  for (let i = 0; i < 2; i++) {
    const b = beltButtons[i], type = L.belt[i], fx = L.beltFxUntil[i] > L.time ? L.beltFx[i] : null, icon = type || fx;
    if (b.dataset.icon !== (icon || "")) {
      b.dataset.icon = icon || ""; const img = b.firstElementChild; img.hidden = !icon;
      if (icon) img.src = `assets/ui/icons/pu-${icon}.webp`;
    }
    b.dataset.type = type || "";
    b.classList.toggle("empty", !icon); b.classList.toggle("active", !!fx);
    b.classList.toggle("counter", !!type && !!L.threat && L.threat.counter === type && save.tacticsPerfect < 3);
    b.setAttribute("aria-label", L.swap ? `Swap ${L.swap.type} into slot ${i + 1}` : type ? `Use ${type}, slot ${i + 1}` : `Empty slot ${i + 1}`);
  }
  $("surgeButton").hidden = !L.surgeReady || L.bankLocked;
  $("count").classList.toggle("ready", L.surgeReady);
  $("swapChip").hidden = !L.swap || !!(hud.externalSwap && !hud.externalSwap.hidden);
  if (L.swap && $("swapIcon").dataset.type !== L.swap.type) {
    $("swapIcon").dataset.type = L.swap.type; $("swapIcon").src = `assets/ui/icons/pu-${L.swap.type}.webp`;
  }
}
function beltChanged() { bus.emit("belt", { slots: L.belt.slice() }); updateBeltHUD(); }
function expireSwap() {
  if (!L.swap) return;
  const type = L.swap.type; L.swap = null;
  addSoldiers(8); floatText(L.sx, 2.5, L.sz, "+8", "#7fd0ff");
  bus.emit("swapExpired", { type }); updateBeltHUD();
}
function collectPowerup(type) {
  if (!L || L.bankLocked || !["shield", "airstrike", "giant", "jackpot"].includes(type)) return false;
  if (type === "jackpot") { window.Powerups?.activate(type); return true; }
  const slot = L.belt.indexOf(null);
  if (slot < 0) {
    // A second pickup settles the earlier offer first, so no supplies silently disappear.
    expireSwap(); L.swap = { type, until: L.time + 3 };
    bus.emit("swapOffer", { type, until: L.swap.until }); updateBeltHUD(); return true;
  }
  L.belt[slot] = type; beltChanged(); bus.emit("powerupGot", { type, slot }); coachCounter(); return true;
}
function coachCounter() {
  if (!L || L.coach || (state !== "play" && state !== "boss")) return;
  for (const t of L.threats) {
    if (!t.teaching || t.done || t.coached || (save.tacticsCounters[t.counter] || 0) >= 2) continue;
    const slot = L.belt.indexOf(t.counter); if (slot < 0) continue;
    t.coached = true; L.coach = t.id;
    // kind is the power-up being taught (airstrike/giant/shield), slot is zero-based.
    bus.emit("tacticsCoach", { kind: t.counter, slot }); return;
  }
}
function rewardPerfect(type, slow = true) {
