    22	  function sprite(map, w, h, order) {
    23	    const m = new THREE.Mesh(new THREE.PlaneBufferGeometry(1, 1), spriteMat(map)); m.scale.set(w, h, 1); m.renderOrder = order || 8; m.visible = false; m.frustumCulled = false; root.add(m); return m;
    24	  }
    25	  const BUBBLE_VS = "varying vec3 vN; varying vec3 vV; varying float vY; void main(){ vec4 mv = modelViewMatrix * vec4(position, 1.0); vN = normalize(normalMatrix * normal); vV = normalize(-mv.xyz); vY = position.y; gl_Position = projectionMatrix * mv; }";
    26	  const BUBBLE_FS = "uniform vec3 uColor; uniform float uOp; uniform float uTime; varying vec3 vN; varying vec3 vV; varying float vY;" +
    27	    "void main(){ float f = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), 2.2); float band = 0.5 + 0.5 * sin(vY * 9.0 - uTime * 2.5);" +
    28	    "float a = (0.07 + 0.8 * f + 0.07 * band) * uOp; gl_FragColor = vec4(uColor * (0.8 + 0.7 * f), a); }";
    29	  const RING_VS = "varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }";
