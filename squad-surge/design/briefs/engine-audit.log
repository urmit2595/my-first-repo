   293	        float fr = pow(1.0 - max(dot(n, v), 0.0), 3.0);
   294	        float band = 0.5 + 0.5 * sin(p.x * 0.18 + sin(p.y * 0.07 + t * 0.2) * 2.0);
   295	        vec3 col = mix(deep, shallow, 0.35 + 0.4 * band);
   296	        col = mix(col, skyCol, fr * 0.35);
   297	        float foam = smoothstep(0.9, 1.0, sin(dot(p, vec2(0.5, 0.86)) * 1.3 + t * 1.1 + sin(p.x * 0.4) * 1.5));
