      var frames = Math.floor(time * 60);
      for (var f = 0; f < frames; f++) for (i = 0; i < heroes.length; i++) heroes[i].update(1 / 60, (f + 1) / 60, states);
      for (i = 0; i < heroes.length; i++) heroes[i].update(time - frames / 60, time, states);
      tb.time = time;
      Object.defineProperty(tb, \"time\", { configurable: true, get: function () { return time; }, set: function () {} });
    }
    var liveTime = 0;
    tb.onFrame(function (dt) {
      if ("'!frozen) {
        liveTime += dt;
        for (var j = 0; j < heroes.length; j++) {
          if (params.get("walkto") === "1") {
            var p = heroes[j].object3D, a = liveTime * 1.5, radius = small ? 0.6 : 0.20;
            p.position.set(Math.sin(a) * radius, 0, Math.sin(a * 2) * radius * 0.5);
            var desired = Math.atan2(Math.cos(a), Math.cos(a * 2));
            var difference = Math.atan2(Math.sin(desired - p.rotation.y), Math.cos(desired - p.rotation.y));
            p.rotation.y += difference * (1 - Math.exp(-dt * 12));
          }
          heroes[j].update(dt, liveTime, states);
        }
      }
      placeLabels();
    });
    placeLabels();
    // Exposed for console inspection and the screenshot harness.
    window.hero = heroes[0]; window.heroes = heroes;
    window.addEventListener("pagehide", function () {
      try { heroes.forEach(function (h) { h.dispose(); }); background.dispose(); } catch (error) { console.error(error); }
    });
  });
})();
</script>
</body>
</html>
