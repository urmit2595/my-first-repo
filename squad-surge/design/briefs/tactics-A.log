}
function setSkin(skinId, tracerId) {
  if (skinId && SKINS[skinId]) save.skin = skinId;
  if (tracerId && TRACERS[tracerId]) save.tracer = tracerId;
  persist(); applySkin();
}
function applySkin() {
  if (!layers) return;
  const s = SKINS[save.skin] || SKINS.classic, u = layers.sold.mesh.material.uniforms.recolor.value;
  if (s.hue === undefined) u.set(0, 1, 1, 0); else u.set(s.hue, s.sat, s.val, 1);
}

function step(dt) {
  L.time += dt;
  const n = L.soldiers.length;
  // steering
  const kx = (keys.ArrowLeft || keys.a ? -1 : 0) + (keys.ArrowRight || keys.d ? 1 : 0);
  L.targetX += kx * dt * 9;
  const lim = Math.max(0.6, ROAD - Math.min(squadRadius(n) * 0.8, ROAD - 0.6));
  L.targetX = Math.max(-lim, Math.min(lim, L.targetX));
  L.sx += (L.targetX - L.sx) * Math.min(1, dt * 12);
  if (state === "bonus") { bonusStep(dt); return; }
  const prevZ = L.sz;
  if (state === "play") {
    L.sz -= SPEED * L.speedMul * dt;
    if (L.sz <= -L.length) {
      L.sz = -L.length; state = "boss"; setState("boss"); L.boss.state = "walk"; vibe(80);
      L.boss.z = Math.min(L.boss.z, L.sz - squadRadius(L.soldiers.length) - 10); // fair fight window for any squad size
      setShield(0); setGiant(0); // power-ups never carry into the boss fight: the slam dodge stays real
      bus.emit("bossStart", { boss: L.boss });
    }
  }
  // combo, SURGE and power-up timers
  L.popSfx -= dt;
  if (L.comboT > 0 && L.surgeT <= 0) { L.comboT -= dt; if (L.comboT <= 0) breakCombo(); }
  if (L.surgeT > 0) { L.surgeT -= dt; L.surge = Math.max(0, L.surgeT / SURGE_TIME); if (L.surgeT <= 0) { L.surge = 0; L.comboT = COMBO_WINDOW; bus.emit("surge", { on: false }); } }
  else { L.idleT += dt; if (L.idleT > 3) L.surge = Math.max(0, L.surge - dt * 0.05); }
  if (L.shieldT > 0) { L.shieldT -= dt; if (L.shieldT <= 0) bus.emit("shield", { on: false }); }
  if (L.giantT > 0) { L.giantT -= dt; if (L.giantT <= 0) bus.emit("giant", { on: false }); }
  for (const m of [100, 250, 500]) if (L.soldiers.length >= m && L.milestone < m) {
    L.milestone = m; bus.emit("squadMilestone", { n: m });
    floatText(L.sx, 3.4, L.sz, m >= 500 ? "ULTRA SQUAD!" : m >= 250 ? "MEGA SQUAD!" : "BIG SQUAD!", "#7fd0ff");
  }
  // soldiers follow formation
  L.soldiers.forEach((s, i) => {
    const [ox, oz] = slot(i);
    s.x += (L.sx + ox - s.x) * Math.min(1, dt * 10); s.z += (L.sz + oz - s.z) * Math.min(1, dt * 10);
    s.x = Math.max(-ROAD + 0.3, Math.min(ROAD - 0.3, s.x));
  });
  // gates
  for (const g of L.gates) {
    if (g.used || !(prevZ > g.z && L.sz <= g.z)) continue;
    g.used = true;
    const h = g.halves.find(h => (L.sx < 0) === (h.side < 0));
    const before = L.soldiers.length;
    const after = h.op === "x" ? Math.round(before * h.v) : before + h.v;
    if (after > before) {
      const gain = after - before;
      addSoldiers(gain); sfx("gate"); floatText(L.sx, 2, L.sz, h.op === "x" ? `x${h.v}` : `+${gain}`, h.jackpot ? "#ffd84a" : "#7fd0ff");
      addScore(gain * POINTS.soldier, { raw: true, x: L.sx, z: L.sz, reason: "gate" }); fillSurge(Math.min(0.15, gain / 200));
      if (h.jackpot || (h.op === "x" && h.v >= 3)) slowMo(0.4, 0.45); else if (gain >= Math.max(10, before * 0.4)) hitStop(0.07);
    }
    else if (after < before) { killSoldiers(before - after, null, true); breakCombo(); sfx("bad"); vibe(60); flashRed(); floatText(L.sx, 2, L.sz, `${after - before}`, "#ff6a5a"); }
    Obj3D.gateUsed(g, h);
    bus.emit("gatePass", { gate: g, half: h, before, after });
  }
