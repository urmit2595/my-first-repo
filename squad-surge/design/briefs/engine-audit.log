   110	    for (const [a, b] of iv) { gap = Math.max(gap, a - cur); cur = Math.max(cur, b); }
   111	    return Math.max(gap, C.ROAD - cur) >= 3.2;
   112	  }
   113	  function planAirdrops(rng, level, length) {
   114	    const n = level === 1 ? 1 : (rng() < 0.5 ? 1 : 2);
   115	    const fr = level === 1 ? [0.45] : n === 1 ? [0.3 + 0.4 * rng()] : [0.25 + 0.15 * rng(), 0.55 + 0.2 * rng()];
   116	    fr.forEach((f, i) => {
   117	      const lead = 35 + rng() * 10, power = level === 1 && i === 0 ? "airstrike" : pickPower(rng);
   118	      const xs = [3.2, -3.2, 1.8, -1.8, 0, 4.2, -4.2].sort(() => rng() - 0.5);
   119	      let best = null;
   120	      for (let dz = 0; dz < 60 && !best; dz += 3) for (const sgn of dz ? [1, -1] : [1]) {
   121	        const z = -length * Math.min(0.78, f) + sgn * dz; if (z > -30 || z < -length * 0.8) continue;
   122	        for (const x of xs) if (spotFree(x, z, 1.2, 5)) { best = { x, z }; break; }
   123	        if (best) break;
