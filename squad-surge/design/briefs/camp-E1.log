    W.cargo = loadTex("assets/fx-extra/cargo-plane.webp"); W.jet = loadTex("assets/fx-extra/jet.webp"); W.chute = loadTex("assets/fx-extra/parachute-crate.webp");
    planeM = sprite(W.cargo, 9, 9 * 390 / 686, 8);
