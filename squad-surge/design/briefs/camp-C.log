  const type = L.belt[slot]; if (!type) return false;
  const threat = L.threat, perfect = !!threat && threat.counter === type, misused = !!threat && !perfect, wasted = !threat && !hasPowerTarget(type);
  L.belt[slot] = null; L.beltFx[slot] = type; L.beltFxUntil[slot] = L.time + (type === "airstrike" ? 2.5 : 6);
  L.tactics.used++; if (wasted) L.tactics.wasted++; if (misused) L.tactics.misused++;
  if (perfect) { threat.countered = true; rewardPerfect(type); }
  beltChanged();
  bus.emit("powerupUse", { type, slot, perfect, misused, wasted, threatKind: threat ? threat.kind : null });
  window.Powerups?.activate(type); return true;
}
function threatLossLeft(t) { if (t.countered) return 0; return Math.max(0, Math.min(t.lossCap - t.lost, L.soldiers.length - Math.max(3, Math.ceil(t.startSquad * 0.6)))); }
function announceThreat(t) {
  t.announced = true; Obj3D.threatSign(t);
  bus.emit("threat", { id: t.id, kind: t.kind, counter: t.counter, z: t.z });
}
function liveThreat(t) {
  t.live = true; L.threat = t;
  t.startSquad = L.soldiers.length;
  t.lossCap = Math.max(4, Math.ceil(t.startSquad * (L.level >= 7 ? 0.20 : L.level >= 4 ? 0.16 : 0.12)));
  if (t.kind === "swarm") {
    const count = Math.min(90, Math.max(12 + 3 * L.level, Math.round(t.startSquad * 0.3)));
    for (let i = 0; i < count; i++) {
      const e = enemy(L.theme.enemy, (i % 9 - 4) * 0.85, t.z - Math.floor(i / 9) * 0.8, L.level);
      e.hp = e.maxHp = Math.max(e.hp, 60 + L.level * 3, t.startSquad * 0.6);
      e.dmg = Math.max(e.dmg, Math.ceil(t.startSquad * 0.015));
      e.sp *= 1.5;
      e.threat = t; L.enemies.push(e); t.actors.push(e);
    }
  } else if (t.kind === "barricade") {
    for (let i = 0; i < 3; i++) t.actors.push(spawnSolid("barricade", -4.2 + i * 3.6 + (t.gap < 0 ? 1.2 : 0), t.z, Math.max(70 + L.level * 8, t.startSquad * 25), { threat: t }));
  } else if (t.kind === "mortars") {
    for (let i = 0; i < (L.level >= 6 ? 2 : 1); i++) t.actors.push(spawnSolid("mortar", (i ? 1 : -1) * 5.2, t.z - 32, Math.max(22 + L.level * 4, t.startSquad * 8), { threat: t }));
  }
  bus.emit("threatLive", { id: t.id, kind: t.kind }); coachCounter(); updateBeltHUD();
}
function endThreat(t) {
  if (!t || t.done) return;
  t.done = true; t.live = false;
  if (t.vis) { t.vis.sign.visible = t.vis.ring.visible = t.vis.shell.visible = false; }
  if (L.threat === t) L.threat = null;
  if (L.coach === t.id) L.coach = null;
  bus.emit("threatEnd", { id: t.id, kind: t.kind, countered: t.countered, lost: t.lost }); updateBeltHUD();
}
function updateTactics(dt) {
  if (L.swap && L.time >= L.swap.until) expireSwap();
  coachCounter();
  if (L.bankLocked) return;
  if (state === "boss" && !L.threat && L.boss.hp > 0) {
    const t = { id: `slam-${L.slamId = (L.slamId || 0) + 1}`, kind: "slam", counter: "shield", z: L.boss.z, actors: [], age: 0, lost: 0, countered: false };
    announceThreat(t); liveThreat(t);
  }
  if (state === "play") for (const t of L.threats) {
    if (t.done) continue;
    const d = L.sz - t.z;
    if (!t.announced && d <= 24 + 2.5 * SPEED * L.speedMul) announceThreat(t);
    if (!t.live && d <= 24 && !L.threat) liveThreat(t);
  }
  const t = L.threat; if (!t || t.kind === "slam") return;
  t.age += dt;
  if (t.kind === "barricade" && L.giantT > 0 && L.sz - t.z < 12) for (const o of t.actors) if (o.alive) breakSolid(o, true);
  if (t.kind === "mortars") {
    if (t.shellT > 0) {
      t.shellT -= dt;
      const u = Math.min(1, 1 - t.shellT / 0.65);
      t.vis.shell.position.set(t.fromX + (t.targetX - t.fromX) * u, 2 + Math.sin(u * Math.PI) * 10, t.fromZ + (t.targetZ - t.fromZ) * u);
      if (t.shellT <= 0) {
        t.vis.shell.visible = t.vis.ring.visible = false;
        if (L.shieldT <= 0 && Math.abs(L.sx - t.targetX) < 2.8) {
          const loss = Math.min(Math.max(2, Math.ceil(L.soldiers.length * 0.03)), threatLossLeft(t));
          killSoldiers(loss, t.targetX, true); t.lost += loss;
        }
        bus.emit("explosion", { x: t.targetX, z: t.targetZ, radius: 2.8 });
        L.fx.push({ x: t.targetX, y: 0.3, z: t.targetZ, f: 9, t: 0, dur: 0.4, size: 4 });
      }
    }
    t.shotT -= dt;
    if (t.shotT <= 0 && t.age < 5.3) {
      let tower = null; for (const o of t.actors) if (o.alive) { tower = o; break; }
      if (tower) {
        t.shotT = 0.7; t.shellT = 0.65; t.fromX = tower.x; t.fromZ = tower.z; t.targetX = L.sx; t.targetZ = L.sz - SPEED * L.speedMul * 0.65;
        t.vis.ring.position.set(t.targetX, 0.09, t.targetZ); t.vis.ring.visible = t.vis.shell.visible = true;
      }
    }
  }
  let alive = false;
  for (const a of t.actors) if (t.kind === "swarm" ? a.hp > 0 && a.state !== "dead" && a.state !== "dying" : a.alive) { alive = true; break; }
  if ((!alive && !(t.shellT > 0)) || t.age >= 6 || (t.kind === "barricade" && L.sz < t.z - 2)) endThreat(t);
}

