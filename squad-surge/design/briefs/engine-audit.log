   401	        b.quad([[xa, yt, Z0], [xb, yt, Z0], [xb, yt, Z1], [xa, yt, Z1]], [uv(xa, Z0), uv(xb, Z0), uv(xb, Z1), uv(xa, Z1)], white, [0, 1, 0]);
   402	        const dark = new T.Color(0.55, 0.55, 0.55);
   403	        b.quad([[xb, yb, Z0], [xb, yb, Z1], [xb, yt, Z1], [xb, yt, Z0]], [[Z0 / st, yb / st], [Z1 / st, yb / st], [Z1 / st, yt / st], [Z0 / st, yt / st]], [dark, dark, white, white], [s, 0, 0]);
