  <div class="scorebox" id="scoreBox" hidden><div class="score stroke" id="scoreN">0</div><div class="best" id="scoreBest"></div></div>

  <div class="hud" id="hud">
    <button class="round" id="levelsBtn" aria-label="Choose level"><svg viewBox="0 0 24 24" fill="#fff"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg></button>
    <button class="round" id="pauseBtn" aria-label="Pause" hidden><svg viewBox="0 0 24 24" fill="#fff"><rect x="5" y="4" width="5" height="16" rx="1.5"/><rect x="14" y="4" width="5" height="16" rx="1.5"/></svg></button>
    <button class="round" id="settingsBtn" aria-label="Settings"><svg viewBox="0 0 24 24" fill="#fff"><path d="M19.4 13a7.5 7.5 0 0 0 0-2l2-1.6-2-3.4-2.4 1a7 7 0 0 0-1.7-1L15 3.5h-4L10.7 6a7 7 0 0 0-1.7 1l-2.4-1-2 3.4L6.6 11a7.5 7.5 0 0 0 0 2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 1.7 1l.3 2.5h4l.3-2.5a7 7 0 0 0 1.7-1l2.4 1 2-3.4zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" transform="translate(-1 0)"/></svg></button>
  </div>
  <div class="levelpill" id="levelPill">
    <div class="name" id="levelName">OLD TOWN</div>
    <div class="lv" id="levelNo">Level 1</div>
    <div class="progress" id="progress" hidden><i id="progFill"></i><b id="progPct">0%</b><span class="flag"></span></div>
  </div>
  <div class="bossbar" id="bossbar" hidden><div class="label stroke" id="bossLabel"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" stroke="#0d1630" stroke-width="1.6" d="M12 2C7 2 3.5 5.6 3.5 10.2c0 2.6 1.2 4.6 3 5.8V19a1 1 0 0 0 1 1h1.5v-2h2v2h2v-2h2v2h1.5a1 1 0 0 0 1-1v-3c1.8-1.2 3-3.2 3-5.8C20.5 5.6 17 2 12 2z"/><circle cx="8.7" cy="11" r="2.1" fill="#0d1630"/><circle cx="15.3" cy="11" r="2.1" fill="#0d1630"/></svg>OGRE WARLORD</div><div class="bar"><i id="bossFill"></i></div></div>
  <div class="weapon-tag" id="weaponTag" hidden><img id="weaponImg" src="assets/w-pistol.png" alt=""><span id="weaponName">PISTOL</span></div>

  <div class="belt" id="belt" hidden>
    <button class="belt-slot empty" id="belt0" data-slot="0" aria-label="Empty slot 1"><img alt="" hidden><small>1 / Q</small></button>
    <button class="belt-slot empty" id="belt1" data-slot="1" aria-label="Empty slot 2"><img alt="" hidden><small>2 / E</small></button>
    <button class="surge-button" id="surgeButton" hidden>SURGE READY</button>
    <div class="swap-chip" id="swapChip" hidden><img id="swapIcon" alt=""> SWAP? <small>tap a slot</small></div>
  </div>
  <div class="home" id="home">
    <div class="logo" id="logo"><img id="logoImg" src="assets/ui/logo.webp" alt="Squad Surge" hidden><b>SQUAD</b><b>SURGE</b></div>
    <div>
      <div class="hint"><div class="pill">HOLD &amp; DRAG <span class="arrows"><i>◀</i><i>▶</i></span></div><div class="line"></div>
        <svg class="hand" viewBox="0 0 24 24" fill="#fff" stroke="#0d1630" stroke-width="1.2"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10h.5V8.5a1.5 1.5 0 0 1 3 0V10h.5v-.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L4.6 14a1.5 1.5 0 0 1 2.4-1.8L9 14z"/></svg></div>
      <button class="btn go playbtn stroke" id="playBtn">PLAY</button>
    </div>
  </div>

  <div class="modal" id="winModal" hidden><div class="panel" role="dialog" aria-labelledby="winTitle">
    <h2 id="winTitle" class="stroke">LEVEL COMPLETE!</h2>
    <div class="stars" id="stars"></div>
    <div class="sub" id="winSub"></div>
    <button class="btn go" id="nextBtn">NEXT LEVEL</button>
  </div></div>

  <div class="modal" id="loseModal" hidden><div class="panel" role="dialog" aria-labelledby="loseTitle">
    <h2 id="loseTitle" class="stroke">SQUAD WIPED OUT</h2>
    <div class="sub">You reached</div>
    <div class="bigpct stroke" id="losePct">0%</div>
    <div class="sub" id="loseBest"></div>
    <button class="btn go" id="retryBtn">TRY AGAIN</button>
  </div></div>

  <div class="modal" id="levelsModal" hidden><div class="panel" role="dialog" aria-labelledby="levelsTitle">
    <h2 id="levelsTitle" class="stroke">LEVELS</h2>
    <div class="lvgrid" id="lvgrid"></div>
    <button class="btn alt" id="levelsClose">BACK</button>
  </div></div>

  <div class="modal" id="pauseModal" hidden><div class="panel" role="dialog" aria-labelledby="pauseTitle">
    <h2 id="pauseTitle" class="stroke">PAUSED</h2>
    <div class="toggle">SOUND <button id="soundBtn" aria-pressed="true">ON</button></div>
    <div class="toggle">VIBRATION <button id="vibeBtn" aria-pressed="true">ON</button></div>
    <button class="btn go" id="resumeBtn">RESUME</button>
    <button class="btn alt" id="quitBtn">RESTART LEVEL</button>
  </div></div>

  <div class="loading" id="loading"><div><img class="loadlogo" src="assets/ui/logo.webp" alt=""><div class="loadbar"><i></i></div><div class="loadtxt">LOADING…</div><div class="err" id="loadErr"></div></div></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="js/scenery.js"></script>
<script src="js/objects3d.js"></script>
<script src="js/juice.js"></script>
<script src="js/powerups.js"></script>
<script src="js/finale.js"></script>
<script src="js/meta.js"></script>
<script>
"use strict";
// ---------- persistence ----------
const SAVE_KEY = "squad-surge-v1";
const save = (() => { try { return JSON.parse(localStorage.getItem(SAVE_KEY)) || {}; } catch (e) { console.warn("save unreadable", e); return {}; } })();
Object.assign(save, { level: 1, unlocked: 1, best: {}, stars: {}, bestSquad: {}, bestScore: {}, skin: "classic", tracer: "gold", sound: true, vibe: true, ...save });
save.tacticsPerfect = Math.max(0, Number(save.tacticsPerfect) || 0);
save.tacticsCounters = save.tacticsCounters && typeof save.tacticsCounters === "object" ? save.tacticsCounters : {};
save.unlocked = Math.max(save.unlocked, save.level);
for (const k of ["coins", "gems", "up"]) delete save[k]; // drop old shop data from earlier builds
function persist() { try { localStorage.setItem(SAVE_KEY, JSON.stringify(save)); } catch (e) { console.warn("save failed", e); } }

// ---------- constants ----------
const ROAD = 6;               // road half-width
const SPEED = 8.5;            // squad forward speed (units/s)
const BULLET_SPEED = 72, BULLET_RANGE = 46;
const MAX_SHOOTERS = 48;
const START_SQUAD = 5;
// Surge Update tuning (design/engagement.md; numbers from the design review)
const COMBO_WINDOW = 3.0;                                          // seconds between kills before the combo drops
const COMBO_TIERS = [[100, 4, "UNSTOPPABLE"], [50, 3, "SURGE!"], [25, 2, "GREAT"], [10, 1.5, "NICE"]]; // [combo, multiplier, callout]
const SURGE_TIME = 6, SURGES_PER_LEVEL = 2;                       // fever: double damage + pierce
const POINTS = { kill: 10, brute: 60, soldier: 2, blockBlue: 10, blockYellow: 40, crate: 50, tyres: 30, weaponCase: 100, ammo: 50, airdrop: 100, barrel: 25 };
const MODIFIERS = {                                               // daily challenge twists (gameplay lives in generateLevel/startLevel)
  arsenal: { name: "BAZOOKA DAY", desc: "Start with the bazooka", scoreMult: 1 },
  horde: { name: "HORDE NIGHT", desc: "70% more enemies · score x1.5", scoreMult: 1.5 },
  brutes: { name: "BRUTE FORCE", desc: "Brutes in every horde · score x1.4", scoreMult: 1.4 },
  jackpot: { name: "LUCKY GATES", desc: "Jackpot gates everywhere", scoreMult: 1 },
  swift: { name: "DOUBLE TIME", desc: "Faster run and fire · score x1.3", scoreMult: 1.3 },
  lone: { name: "LONE WOLF", desc: "Start with 1 soldier, double +blocks · score x1.3", scoreMult: 1.3 },
};
const SKINS = {                                                    // squad colours: recolour the blue uniform and helmet in the sprite shader
  classic: { name: "CLASSIC BLUE" }, crimson: { name: "ROSE", hue: 0.93, sat: 0.8, val: 1.05 }, /* not red: red helmets are the grunt enemies */
  jungle: { name: "JUNGLE", hue: 0.27, sat: 0.75, val: 0.85 }, arctic: { name: "ARCTIC", hue: 0.58, sat: 0.12, val: 1.25 },
  desert: { name: "DESERT", hue: 0.09, sat: 0.5, val: 1.05 }, violet: { name: "VIOLET", hue: 0.77, sat: 0.9, val: 1.0 },
  gold: { name: "GOLD", hue: 0.12, sat: 0.95, val: 1.2 }, shadow: { name: "SHADOW OPS", hue: 0.62, sat: 0.35, val: 0.45 },
};
const TRACERS = { gold: { name: "GOLD", rgb: [1, 1, 1] }, plasma: { name: "PLASMA", rgb: [0.45, 0.8, 1.7] }, toxic: { name: "TOXIC", rgb: [0.6, 1.5, 0.5] }, inferno: { name: "INFERNO", rgb: [1.6, 0.55, 0.35] }, rainbow: { name: "RAINBOW", rainbow: true } };
const WEAPONS = [
  { name: "PISTOL", img: "assets/w-pistol.png", dmg: 1, rate: 1, spread: 1 },
  { name: "RIFLE", img: "assets/w-rifle.png", dmg: 1.4, rate: 1.35, spread: 1 },
  { name: "SHOTGUN", img: "assets/w-shotgun.png", dmg: 1.2, rate: 1, spread: 3 },
  { name: "MINIGUN", img: "assets/w-minigun.png", dmg: 1.3, rate: 2.4, spread: 1 },
  { name: "BAZOOKA", img: "assets/w-bazooka.png", dmg: 7, rate: 0.4, spread: 1, splash: 2.6 },
];
const THEMES = [
  { id: "town", name: "OLD TOWN", sky: ["#f9c48f", "#fde8c9"], fog: 0xf6d2aa, ground: "t-dirt", road: "t-asphalt", side: "t-cobble", enemy: "zombie", deco: "city", landmark: "tower" },
  { id: "bridge", name: "GOLDEN BRIDGE", sky: ["#6fb6ff", "#d8eeff"], fog: 0xbfe0ff, ground: null, water: 0x2f8fd0, road: "t-asphalt", side: "t-concrete", enemy: "grunt", deco: "bridge" },
  { id: "pier", name: "OLD PIER", sky: ["#7fd3e6", "#e9fbff"], fog: 0xc6eef5, ground: null, water: 0x1d9fb8, road: "t-concrete", side: "t-cobble", enemy: "zombie", deco: "pier" },
  { id: "ruins", name: "RUINED CITY", sky: ["#9aa7b8", "#e7d6c2"], fog: 0xcfc6bb, ground: "t-dirt", road: "t-asphalt", side: "t-cobble", enemy: "grunt", deco: "city" },
  { id: "desert", name: "DESERT HIGHWAY", sky: ["#ffb36b", "#ffe9b8"], fog: 0xf5d6a0, ground: "t-dirt", road: "t-asphalt", side: "t-dirt", enemy: "zombie", deco: "desert" },
  { id: "arena", name: "WAR ARENA", sky: ["#24345f", "#5a6d9a"], fog: 0x3b4c78, ground: null, water: 0x1a2546, road: "t-concrete", side: "t-concrete", enemy: "grunt", deco: "arena" },
];

// ---------- DOM ----------
const $ = id => document.getElementById(id);
const gameEl = $("game"), canvas = $("view");
{ // title logo image, with the text logo as fallback
  const img = $("logoImg");
  img.onload = () => { img.hidden = false; $("logo").classList.add("has-img"); };
  img.onerror = () => img.remove();
  if (img.complete && img.naturalWidth) img.onload();
}

// ---------- three setup ----------
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: "high-performance" });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
const scene = new THREE.Scene();
const BASE_FOV = 60;
const CAM = { h: 9.5, back: 10, ahead: 20 }; // chase camera: height, distance behind the squad, aim point ahead of it
const camera = new THREE.PerspectiveCamera(BASE_FOV, 9 / 16, 0.5, 400);
const loader = new THREE.TextureLoader();
const TEX = {};
function loadTex(name, file) {
  return new Promise((res, rej) => loader.load(file, t => { t.anisotropy = 4; TEX[name] = t; res(t); }, undefined, () => rej(new Error(`Could not load ${file}`))));
}
function resize() {
  const w = gameEl.clientWidth, h = gameEl.clientHeight;
  renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();
}
addEventListener("resize", resize);

// ---------- instanced sprite layers ----------
const SPRITE_VS = `
#include <fog_pars_vertex>
attribute vec3 aOff; attribute vec2 aScale; attribute vec3 aFrame;
uniform vec2 grid; varying vec2 vUv; varying float vA; varying float vFlash;
void main(){
  vec4 mvPosition = modelViewMatrix * vec4(aOff, 1.0);
  mvPosition.xy += position.xy * aScale;
  gl_Position = projectionMatrix * mvPosition;
  float f = aFrame.x; float c = mod(f, grid.x); float r = floor(f / grid.x + 0.001);
  vUv = vec2((c + uv.x) / grid.x, 1.0 - (r + 1.0 - uv.y) / grid.y);
  vA = aFrame.y; vFlash = aFrame.z;
  #include <fog_vertex>
}`;
const SPRITE_FS = `
#include <fog_pars_fragment>
uniform sampler2D map; uniform vec3 tint; uniform vec4 recolor; varying vec2 vUv; varying float vA; varying float vFlash;
vec3 rgb2hsv(vec3 c){ vec4 K = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x); }
vec3 hsv2rgb(vec3 c){ vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0); return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y); }
void main(){
  vec4 t = texture2D(map, vUv);
  if (t.a * vA < 0.5) discard;
  vec3 col = t.rgb;
  if (recolor.w > 0.5) { // squad colour: re-hue only the blue uniform and helmet
    vec3 h = rgb2hsv(col);
    float m = (1.0 - smoothstep(0.05, 0.11, abs(h.x - 0.6))) * smoothstep(0.18, 0.32, h.y);
    col = mix(col, hsv2rgb(vec3(recolor.x, clamp(h.y * recolor.y, 0.0, 1.0), clamp(h.z * recolor.z, 0.0, 1.0))), m);
  }
  gl_FragColor = vec4(mix(col * tint, vec3(1.0), vFlash), 1.0);
  #include <fog_fragment>
}`;
const FX_FS = `
#include <fog_pars_fragment>
uniform sampler2D map; uniform vec3 tracer; varying vec2 vUv; varying float vA; varying float vFlash;
void main(){
  vec4 t = texture2D(map, vUv); vec3 c = t.rgb * vA;
  if (vFlash > 0.5) c *= tracer; // bullets are pushed with flash = 1: tint them with the tracer colour
  gl_FragColor = vec4(c, 1.0);
  #ifdef USE_FOG
    gl_FragColor.rgb *= 1.0 - smoothstep(fogNear, fogFar, fogDepth); // additive: fade out instead of tinting
  #endif
}`;
const spriteLayers = [];
class SpriteLayer {
  constructor(tex, cols, rows, max, { additive = false, anchor = 0 } = {}) {
    const base = new THREE.PlaneBufferGeometry(1, 1); base.translate(0, 0.5 - anchor, 0);
    const g = new THREE.InstancedBufferGeometry();
    g.index = base.index; g.setAttribute("position", base.attributes.position); g.setAttribute("uv", base.attributes.uv);
    this.off = new Float32Array(max * 3); this.sc = new Float32Array(max * 2); this.fr = new Float32Array(max * 3);
    this.aOff = new THREE.InstancedBufferAttribute(this.off, 3).setUsage(THREE.DynamicDrawUsage);
    this.aSc = new THREE.InstancedBufferAttribute(this.sc, 2).setUsage(THREE.DynamicDrawUsage);
    this.aFr = new THREE.InstancedBufferAttribute(this.fr, 3).setUsage(THREE.DynamicDrawUsage);
    g.setAttribute("aOff", this.aOff); g.setAttribute("aScale", this.aSc); g.setAttribute("aFrame", this.aFr);
    g.instanceCount = 0;
    const uniforms = THREE.UniformsUtils.merge([THREE.UniformsLib.fog]); // merge first: it would clone a texture value
    Object.assign(uniforms, { map: { value: tex }, grid: { value: new THREE.Vector2(cols, rows) }, tint: { value: new THREE.Color(1, 1, 1) }, recolor: { value: new THREE.Vector4(0, 1, 1, 0) }, tracer: { value: new THREE.Vector3(1, 1, 1) } });
    const mat = new THREE.ShaderMaterial({
      uniforms, fog: true,
      vertexShader: SPRITE_VS, fragmentShader: additive ? FX_FS : SPRITE_FS,
      transparent: additive, depthWrite: !additive, blending: additive ? THREE.AdditiveBlending : THREE.NormalBlending,
    });
    this.mesh = new THREE.Mesh(g, mat); this.mesh.frustumCulled = false; this.mesh.renderOrder = additive ? 5 : 1;
    this.g = g; this.max = max; this.n = 0; this.additive = additive; scene.add(this.mesh); spriteLayers.push(this);
  }
  begin() { this.n = 0; }
  push(x, y, z, w, h, frame, alpha = 1, flash = 0) {
    if (this.n >= this.max) return;
    const i = this.n++;
    this.off[i * 3] = x; this.off[i * 3 + 1] = y; this.off[i * 3 + 2] = z;
    this.sc[i * 2] = w; this.sc[i * 2 + 1] = h;
    this.fr[i * 3] = frame; this.fr[i * 3 + 1] = alpha; this.fr[i * 3 + 2] = flash;
  }
  end() { this.g.instanceCount = this.n; this.aOff.needsUpdate = this.aSc.needsUpdate = this.aFr.needsUpdate = true; }
}
// flat blob shadows on the ground
class ShadowLayer {
  constructor(max) {
    const c = document.createElement("canvas"); c.width = c.height = 64;
    const x = c.getContext("2d"), gr = x.createRadialGradient(32, 32, 0, 32, 32, 32);
    gr.addColorStop(0, "rgba(0,0,0,.62)"); gr.addColorStop(0.35, "rgba(0,0,0,.5)"); gr.addColorStop(1, "rgba(0,0,0,0)"); x.fillStyle = gr; x.fillRect(0, 0, 64, 64);
    const base = new THREE.PlaneBufferGeometry(1, 1); base.rotateX(-Math.PI / 2);
    this.mesh = new THREE.InstancedMesh(base, new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(c), transparent: true, depthWrite: false }), max);
    this.mesh.frustumCulled = false; this.mesh.renderOrder = 0; this.max = max; this.m = new THREE.Matrix4(); scene.add(this.mesh);
  }
  begin() { this.n = 0; }
  push(x, z, s) { if (this.n >= this.max) return; this.m.makeScale(s, 1, s * 0.7); this.m.setPosition(x, 0.03, z); this.mesh.setMatrixAt(this.n++, this.m); }
  end() { this.mesh.count = this.n; this.mesh.instanceMatrix.needsUpdate = true; }
}

// ---------- label textures (numbers on gates / blocks) ----------
function makeLabel(w, h) {
  const c = document.createElement("canvas"); c.width = w; c.height = h;
  const tex = new THREE.CanvasTexture(c); tex.anisotropy = 4;
  return { c, ctx: c.getContext("2d"), tex, last: null };
}
function drawLabel(L, text, color = "#fff", size = 0.62) {
  if (L.last === text) return; L.last = text;
  const { ctx, c } = L; ctx.clearRect(0, 0, c.width, c.height);
  ctx.font = `${Math.round(c.height * size)}px 'Lilita One', sans-serif`; ctx.textAlign = "center"; ctx.textBaseline = "middle";
  ctx.lineJoin = "round"; ctx.lineWidth = c.height * 0.12; ctx.strokeStyle = "#0d1630";
  ctx.strokeText(text, c.width / 2, c.height * 0.54); ctx.fillStyle = color; ctx.fillText(text, c.width / 2, c.height * 0.54);
  L.tex.needsUpdate = true;
}

// ---------- audio ----------
let actx = null;
function sfx(type, pitch = 1) {
  if (!save.sound) return;
  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    const t = actx.currentTime, o = actx.createOscillator(), g = actx.createGain();
    const cfg = { shot: [520, 180, 0.03, 0.035, "square"], hit: [220, 90, 0.05, 0.05, "triangle"], gate: [500, 1000, 0.18, 0.12, "sine"], bad: [300, 110, 0.25, 0.12, "sawtooth"], boom: [120, 40, 0.35, 0.2, "sawtooth"], coin: [900, 1500, 0.1, 0.08, "sine"], pop: [700, 380, 0.07, 0.045, "triangle"], rocket: [180, 70, 0.12, 0.06, "sawtooth"], win: [440, 880, 0.5, 0.15, "triangle"] }[type];
    o.type = cfg[4]; o.frequency.setValueAtTime(cfg[0] * pitch, t); o.frequency.exponentialRampToValueAtTime(cfg[1] * pitch, t + cfg[2]);
    g.gain.setValueAtTime(cfg[3], t); g.gain.exponentialRampToValueAtTime(0.0001, t + cfg[2]);
    o.connect(g).connect(actx.destination); o.start(t); o.stop(t + cfg[2] + 0.02);
  } catch (e) { console.warn("audio unavailable", e); save.sound = false; }
}
const vibe = ms => { if (save.vibe && navigator.vibrate) navigator.vibrate(ms); };

// ---------- RNG ----------
function rng(seed) { return () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; }; }

// ---------- world / level ----------
let L = null;               // current level state
const world = new THREE.Group(); scene.add(world);   // scenery, owned by js/scenery.js
const track = new THREE.Group(); scene.add(track);   // gate and solid visuals, owned by js/objects3d.js
// event bus: the game emits, the look-and-feel modules listen (design/overhaul.md section 6)
const bus = {
  h: {},
  on(name, fn) { (this.h[name] ||= []).push(fn); },
  emit(name, data) { const hs = this.h[name]; if (hs) for (const fn of hs) { try { fn(data); } catch (e) { console.error(`bus ${name}`, e); } } },
};
const spriteTint = new THREE.Color(1, 1, 1);
function setSpriteTint(color) { spriteTint.set(color); for (const l of spriteLayers) if (!l.additive) l.mesh.material.uniforms.tint.value.copy(spriteTint); }
const ctx = {
  THREE, renderer, scene, camera, world, track, ROAD, TEX, bus, save, $, gameEl, makeLabel, drawLabel, setSpriteTint, rng,
  get WEAPONS() { return WEAPONS; }, get L() { return L; }, get state() { return state; }, get layers() { return layers; },
  sfx: (...a) => sfx(...a), vibe: ms => vibe(ms), floatText: (...a) => floatText(...a),
  get belt() { return L.belt; }, usePowerup: slot => usePowerup(slot), collectPowerup: type => collectPowerup(type),
  get tactics() { return L.tactics; }, get threat() { return L.threat; }, get surgeReady() { return !!L.surgeReady; },
  useSurge: () => useSurge(), damageBoss: n => damageBoss(n),
