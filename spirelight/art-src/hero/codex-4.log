#!/usr/bin/env node
// Screenshot any Spirelight page headlessly and print errors.
//
//   node tools/shot.js PAGE OUT.png [--w 1280] [--h 720] [--dpr 1] [--wait 1500] [--until "window.__ready"]
//                      [--eval "js expression (awaited), result printed as JSON"] [--mobile] [--reduced] [--log]
//
// PAGE is relative to spirelight/, e.g. "index.html?test" or "tests/hero.html". --until waits (up to 60 s) for an
// expression to be truthy before the --wait delay; it defaults to "window.__ready || (window.Game && Game.ready)".
const path = require("path");
const { open, ROOT } = require("./harness");
const argv = process.argv.slice(2), pos = [], opt = {};
for (let i = 0; i < argv.length; i++) {
  if (argv[i].startsWith("--")) { const k = argv[i].slice(2), v = argv[i + 1]; if (v === undefined || v.startsWith("--")) opt[k] = "1"; else { opt[k] = v; i++; } }
  else pos.push(argv[i]);
}
const [page = "index.html?test", out = "design/qa/shot.png"] = pos;
(async () => {
  const h = await open(page, { w: +(opt.w || 1280), h: +(opt.h || 720), dpr: +(opt.dpr || 1), mobile: !!opt.mobile, reducedMotion: !!opt.reduced, log: !!opt.log });
  const until = opt.until || "window.__ready || (window.Game && Game.ready)";
  await h.page.waitForFunction(until, null, { timeout: 60000 }).catch(() => h.errors.push("timeout waiting for: " + until));
  if (opt.eval) {
    const r = await h.page.evaluate(`(async () => (${opt.eval}))()`).catch(e => "EVAL ERROR " + e.message);
    console.log(JSON.stringify(r));
  }
  await h.page.waitForTimeout(+(opt.wait || 1500));
  const file = path.resolve(ROOT, out);
  await h.page.screenshot({ path: file });
  console.log("saved " + path.relative(ROOT, file));
  console.log(h.errors.length ? "ERRORS:\n" + [...new Set(h.errors)].slice(0, 30).join("\n") : "errors: none");
  await h.close();
})().catch(e => { console.error("FAIL", e.message); process.exit(1); });
// Spirelight testbed: a minimal true-isometric three.js scene for testing one module on its own.
// Include three.min.js (and any examples/js you need) first, then this file, then your module, then:
//
//   Testbed.start({ height: 10, center: [0, 1, 0], bg: 0x241a3a, lights: true, grid: true }, (tb) => {
//     // tb.THREE, tb.scene, tb.camera, tb.renderer, tb.key (DirectionalLight), tb.hemi, tb.time
//     tb.scene.add(myObject);
//     tb.onFrame((dt, t) => { ... });      // per-frame callback
//     return promiseOrNothing;             // window.__ready becomes true after it settles (and 2 frames rendered)
//   });
//
// Camera: orthographic, looking along -(1,1,1) with +y up, exactly the game's projection (design.md section 4).
(function () {
  "use strict";
  const Testbed = {};
  Testbed.start = function (opts, setup) {
    opts = opts || {};
    const THREE = window.THREE;
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;display:block";
    document.body.style.margin = "0";
    document.body.style.background = "#000";
    document.body.appendChild(canvas);
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
    renderer.outputEncoding = THREE.sRGBEncoding;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = opts.exposure || 1.0;
    renderer.shadowMap.enabled = opts.shadows !== false;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(opts.bg != null ? opts.bg : 0x241a3a);
    const H = opts.height || 10, c = opts.center || [0, 0, 0];
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, -200, 400);
    camera.position.set(c[0] + 50, c[1] + 50, c[2] + 50);
    camera.up.set(0, 1, 0);
    camera.lookAt(c[0], c[1], c[2]);
    const tb = { THREE, scene, camera, renderer, canvas, time: 0, frames: [], onFrame(fn) { this.frames.push(fn); } };
    if (opts.lights !== false) {
      tb.hemi = new THREE.HemisphereLight(0xb9c7ff, 0x5a3a52, 0.55);
      scene.add(tb.hemi);
      tb.key = new THREE.DirectionalLight(0xffd2a0, 1.6);
      tb.key.position.set(c[0] - 12, c[1] + 20, c[2] + 8);
      tb.key.target.position.set(c[0], c[1], c[2]);
      tb.key.castShadow = true;
      tb.key.shadow.mapSize.set(2048, 2048);
      const s = tb.key.shadow.camera; s.left = -H; s.right = H; s.top = H; s.bottom = -H; s.near = 0.5; s.far = 80;
