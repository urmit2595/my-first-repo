      const b = new THREE.Mesh(G.band, M.hazard); b.position.set(0, 0.54, z); b.castShadow = true; b.receiveShadow = true; r.add(b); v.body.push({ mesh: b, base: M.hazard, fl: flashOf(M.hazard) });
