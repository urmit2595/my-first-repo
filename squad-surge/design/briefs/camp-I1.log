    rateMult: mod === "swift" ? 1.25 : 1, speedMul: mod === "swift" ? 1.2 : 1, mode: opts.mode || "normal", modifier: mod, seed: opts.seed ?? level * 9973 + 17, scoreMult: mod ? MODIFIERS[mod].scoreMult : 1,
