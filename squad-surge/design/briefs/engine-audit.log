   277	  function newLabel(w, h, worldW, order) {
   278	    const lab = C.makeLabel(w, h); lab.tex.encoding = LIN ? THREE.sRGBEncoding : THREE.LinearEncoding; LTEX.push(lab.tex);
   279	    const m = new THREE.MeshBasicMaterial({ map: lab.tex, transparent: true, depthWrite: false, toneMapped: false }); LMATS.push(m);
   280	    const mesh = new THREE.Mesh(G.plane2, m); mesh.scale.set(worldW, worldW, 1); mesh.renderOrder = order || 5;
   281	    return { lab, mesh, w: worldW };
