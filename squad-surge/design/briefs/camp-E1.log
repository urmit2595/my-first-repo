function slowMo(scale, seconds, force = false) {
  const now = performance.now() / 1000;
  if (!force && (now - time.lastSlow < 4 || (L && L.slowMos >= 3))) return; // rare peaks only
  time.lastSlow = now; time.slowT = seconds; time.target = scale; if (L) L.slowMos++;
}
