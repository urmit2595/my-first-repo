  { id: "score", n: "HIGH ROLLER", d: "Score 50,000 in one level", ic: "star", f: () => S().maxScore >= 50000, p: () => [S().maxScore, 50000] },
  { id: "miss", n: "ON A MISSION", d: "Complete 10 missions", ic: "medal", f: () => S().missions >= 10, p: () => [S().missions, 10] },
