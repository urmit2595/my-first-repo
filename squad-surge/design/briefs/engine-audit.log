    97	  // ---------------------------------------------------------------- level planning (on `generate`)
    98	  function pickPower(rng) {
    99	    let r = rng() * WEIGHTS.reduce((a, w) => a + w[1], 0);
   100	    for (const [k, w] of WEIGHTS) { if ((r -= w) < 0) return k; } return "airstrike";
   101	  }
   102	  // blocked? solids/gates near (x,z); also checks that a barrel/crate there leaves a >= 3.2 wide corridor
   103	  function spotFree(x, z, hw, apart) {
   104	    for (const g of L.gates) if (Math.abs(g.z - z) < 7) return false;
   105	    for (const o of L.solids) if (o.alive && Math.abs(o.z - z) < apart && Math.abs(o.x - x) < o.hw + hw + 1.6) return false;
   106	    for (const p of S.plan) if (Math.abs(p.z - z) < 9) return false;
   107	    const iv = [[x - hw - 0.3, x + hw + 0.3]];
   108	    for (const o of L.solids) if (o.alive && Math.abs(o.z - z) < 3.2) iv.push([o.x - o.hw - 0.3, o.x + o.hw + 0.3]);
