   573	  // ------------------------------------------------------------------ theme extras
   574	  function bridgeExtras(rnd, Z0, Z1, length) {
   575	    const { world } = C, red = lin(0xd24a32), redD = lin(0xa23624), fix = [0.5, 0.5], tw = new Batch(), cb = new Batch(), rl = new Batch();
   576	    const spacing = 60, towerH = 34, topY = 31, sag = 3.0;
