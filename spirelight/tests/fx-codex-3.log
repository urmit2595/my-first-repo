    var tiles = {
      start: { stand: [1.5, 0.58, 3.5], group: "base", ref: [1, 0, 3] },
      middle: { stand: [3, 0.58, 3.5], group: "base", ref: [3, 0, 3] },
      plate: { stand: [4.5, 0.58, 3.5], group: "base", ref: [4, 0, 3] },
      p1: { stand: [4.5, 0.58, 3.5], group: "base", ref: [4, 0, 3] },
      g1: { stand: [2, 1.08, 2], group: "base", ref: [2, 1, 2] },
      bridge_1: { stand: [5, 0.58, 3], group: "bridge", ref: [5, 0, 3] },
      stair: { stand: [2, 1.08, 2], group: "base", ref: [2, 1, 2] },
      goal: { stand: [4.5, 3.12, 1.5], group: "bridge", ref: [4, 3, 1] }
    };
    var pivot = new T.Object3D(); pivot.position.set(5, 0.58, 3); tb.scene.add(pivot);
    var handle = new T.Object3D(); handle.position.set(0, 0.5, 0); pivot.add(handle);
    var knob = new T.Mesh(cube, brass); knob.scale.set(0.28, 0.28, 0.65); handle.add(knob);
    var hero = new T.Object3D(); hero.position.fromArray(tiles.start.stand); tb.scene.add(hero);
    var wick = new T.Mesh(cube, brass); wick.position.y = 0.22; wick.scale.set(0.22, 0.44, 0.22); hero.add(wick);
    var identity = { R: [1, 0, 0, 0, 1, 0, 0, 0, 1], pivot: [5, 0.58, 3], offset: [0, 0, 0] };
    var levelBounds = { min: [0, 0, 1], max: [6, 4, 5] }, screenVector = new T.Vector3();
    var Game = window.Game = {
      THREE: T, scene: tb.scene, camera: tb.camera, renderer: tb.renderer, root: root, ui: ui, bus: bus,
      state: "title", time: 0, dt: 0, quality: query.get("quality") || "high",
      reducedMotion: query.has("reduced") || matchMedia("(prefers-reduced-motion: reduce)").matches,
      save: { sound: query.get("sound") !== "0", music: query.get("music") !== "0", quality: "auto" },
      saveNow: function () {},
      worldToScreen: function (p) {
        screenVector.fromArray(p).project(tb.camera);
        return { x: (screenVector.x + 1) * root.clientWidth / 2, y: (1 - screenVector.y) * root.clientHeight / 2 };
      },
      geom: { walkable: function (id) { return tiles[id] || null; }, transform: function () { return identity; },
        bounds: function () { return levelBounds; } },
      groups: { bridge: { id: "bridge", pivotNode: pivot, handle: { object3D: handle } } },
      hero: { object3D: hero }, decor: [], level: { theme: "dusk" }
    };
    window.__fxLit = [];
    var lanterns = [[4.9, 2.6, 2.3], [3.4, 1.5, 2.2], [5.5, 0.85, 3.9],
      [3.7, 0.85, 4.5], [2.3, 0.85, 4.4], [0.6, 0.85, 4.3]];
    lanterns.forEach(function (pos, i) {
      var mat = new T.MeshStandardMaterial({ color: 0x9c783d, emissive: 0xffb35a, emissiveIntensity: 0.02, roughness: 0.5 });
      var obj = box(pos[0], pos[1], pos[2], 0.19, 0.32, 0.19, mat), world = new T.Vector3();
      obj.userData.target = 0.02;
      obj.userData.setLit = function (on, instant) {
        obj.userData.target = on ? 3 : 0.02;
        if (instant) mat.emissiveIntensity = obj.userData.target;
        if (on) window.__fxLit.push({ index: i, time: Game.time, instant: !!instant });
      };
      Game.decor.push({ item: { type: "lantern" }, object3D: obj, worldPos: function (target) {
        return obj.getWorldPosition(target || world);
      } });
    });
    var beaconWorld = new T.Vector3();
    Game.decor.push({ item: { type: "beacon" }, object3D: beacon,
      worldPos: function (target) { return beacon.getWorldPosition(target || beaconWorld); } });
    FX.setup(Game); FX.setup(Game); // Repeated boot must not duplicate roots, listeners, or ambient particles.
    var defaults = {
      tap: { x: 0, y: 0, tile: "middle", reachable: true, pos: tiles.middle.stand },
      tapUnreachable: { x: 0, y: 0, tile: "p1", reachable: false, pos: tiles.p1.stand },
      path: { points: [tiles.start.stand, tiles.middle.stand, tiles.plate.stand] },
      heroStep: { from: "start", to: "middle", k: 0, at: tiles.start.stand },
      junction: { from: "middle", to: "bridge_1", k: 1, at: tiles.middle.stand },
      mechGrab: { id: "bridge" }, mechMove: { id: "bridge", value: 15, delta: 1 },
      mechTick: { id: "bridge", pos: [5, 1.08, 3] }, mechSnap: { id: "bridge", value: 90, pos: [5, 1.08, 3] },
      mechLocked: { id: "bridge" }, plate: { tile: "p1", group: "base", pos: tiles.p1.stand },
      glimmer: { tile: "g1", count: 1, total: 3, pos: tiles.g1.stand }, beacon: { index: 0, pos: [4.5, 3.95, 1.5] },
      levelComplete: { index: 0 }, levelStart: { index: 0, level: Game.level }, pause: { paused: true },
      quality: { level: "low" }
    };
    var beaconOn = false;
    window.__fxIgnitions = 0;
    beacon.userData.ignite = function () { beaconOn = true; window.__fxIgnitions++; };
    window.__fxFire = function (name, data) {
      try {
        var payload = Object.assign({}, defaults[name] || {}, data || {}), event = name;
        if (name === "tapUnreachable") event = "tap";
        if (name === "junction") event = "heroStep";
        if (event === "levelStart" || event === "restart") {
          Game.state = "play"; Game.level = payload.level || Game.level; beaconOn = false; window.__fxLit.length = 0;
          for (var i = 0; i < 6; i++) Game.decor[i].object3D.userData.setLit(false, true);
        }
        if (event === "title") Game.state = "title";
        if (event === "pause") Game.state = payload.paused ? "paused" : "play";
        if (event === "quality") Game.quality = payload.level;
        if (event === "levelComplete") Game.state = "complete";
        if (event === "beacon") beacon.userData.ignite(); // Fake engine owns the beacon's ignition.
        status.textContent = "FX test · " + name + "\n__fxFire(name, data) · FX.debug()";
        bus.emit(event, payload); return FX.debug();
      } catch (e) { window.__fxReportError(e); throw e; }
    };
    var schedule = [[0.4, "tap"], [1.2, "tapUnreachable"], [2, "path"], [2.4, "heroStep"],
      [2.6, "heroStep"], [2.8, "heroStep"], [3.5, "junction"], [4.2, "mechGrab"],
      [5, "mechTick"], [5.5, "mechSnap"], [6.3, "mechLocked"], [7, "plate"], [8.3, "glimmer"],
      [10, "beacon"], [14, "levelComplete"]];
    var only = query.get("only"), scripted = query.get("script") !== "0", cursor = 0;
    if (only) schedule = [[0.4, only]];
    if (only === "heroStep") schedule = [[0.4, only], [0.5, only], [0.6, only]];
    if (scripted && only !== "title") window.__fxFire("levelStart");
    status.textContent = "FX test · " + (only || (scripted ? "sequence" : "manual")) + "\nClick or press a key to unlock audio";
    tb.onFrame(function (dt, t) {
      try {
        Game.time = t; Game.dt = dt;
        for (var i = 0; i < 6; i++) {
          var obj = Game.decor[i].object3D;
          obj.material.emissiveIntensity += (obj.userData.target - obj.material.emissiveIntensity) * (1 - Math.exp(-dt * 5));
        }
        beaconMat.emissiveIntensity += ((beaconOn ? 3 : 0.12) - beaconMat.emissiveIntensity) * (1 - Math.exp(-dt * 3));
        if (scripted) {
          while (cursor < schedule.length && t >= schedule[cursor][0]) window.__fxFire(schedule[cursor++][1]);
          if (!only && t > 4.4 && t < 5.4 || only === "mechMove" && t > 0.4 && t < 1.4) {
            bus.emit("mechMove", defaults.mechMove);
          }
        }
      } catch (e) { window.__fxReportError(e); }
    });
  });
})();
</script>
</body>
