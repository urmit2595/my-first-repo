      const p = (T * 0.5 + hs.ph * 0.3) % 1.7; hs.shine.visible = p < 1; if (p < 1) { hs.shine.position.x = -PW * 0.4 + p * PW * 0.8; hs.shine.material.opacity = 0.75 * Math.sin(p * Math.PI) * (1 - f); }
    }
  }

  // ---------------------------------------------------------------- solids
  const PICON = {};
