function goMode(o = {}) { return goLevel(o.level || save.level, o.next || "play", o); } // e.g. {mode: "daily", level, modifier, seed}
const sameRun = () => ({ mode: L.mode, modifier: L.modifier, seed: L.seed, mission: L.mission, elite: L.elite });
