  ctx.addScore(300 * L.level, { raw: true, reason: "perfect" });
  const before = L.combo; L.combo += 10; L.comboT = COMBO_WINDOW; L.bestCombo = Math.max(L.bestCombo, L.combo);
  for (const t of COMBO_TIERS) if (before < t[0] && L.combo >= t[0]) bus.emit("combo", { count: L.combo, tier: COMBO_TIERS.length - COMBO_TIERS.indexOf(t), name: t[2], mult: t[1] });
  if (slow) slowMo(0.4, 0.35); persist();
}
function hasPowerTarget(type) {
  if (type === "shield") {
    if (L.threat || (state === "boss" && L.boss.hp > 0)) return true;
    for (const t of L.threats) if (!t.done && L.sz - t.z >= 0 && L.sz - t.z < 24 + SPEED * L.speedMul * 4) return true;
    for (const e of L.enemies) if (e.hp > 0 && e.state !== "dying" && e.state !== "dead" && e.z <= L.sz + 5 && L.sz - e.z < 4 * (SPEED * L.speedMul + e.sp)) return true;
    return false;
  }
  if (state === "boss" && L.boss.hp > 0) return true;
  const range = type === "giant" ? SPEED * L.speedMul * 6 : 60;
