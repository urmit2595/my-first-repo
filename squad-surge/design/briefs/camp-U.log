      if (Array.isArray(src)) src.forEach(x => { const n = String(x.name || x).replace(/\.\w+$/, ""); map[n] = x.file || `assets/ui/icons/${n}.webp`; });
      else Object.keys(src).forEach(n => { map[n] = (src[n] && src[n].file) || `assets/ui/icons/${n}.webp`; });
