    const m = M.missions[i], e = pdef(m.id);
    if (!e || e.k !== kind) continue;
    const before = m.prog;
    if (e.mode === "max") m.prog = Math.max(m.prog, val); else m.prog += val;
    if (m.prog !== before) changed = true;
