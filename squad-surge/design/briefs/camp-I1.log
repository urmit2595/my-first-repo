    if (newBest) save.bestSquad[L.level] = n;
    if (newBestScore) save.bestScore[L.level] = total;
    save.level = L.level + 1; save.campaign = save.campaign && typeof save.campaign === "object" && !Array.isArray(save.campaign) ? save.campaign : {};
save.unlocked = Math.max(save.unlocked, save.level); persist();
  }
  $("stars").innerHTML = starIcons(stars);
  $("winSub").textContent = `${total.toLocaleString()} POINTS${L.mult > 1 ? ` · x${L.mult} FINALE` : ""} · ${n} soldiers${newBestScore ? " · NEW BEST!" : ""}`;
  sfx("win"); setState("win");
  bus.emit("win", { tactics: { ...L.tactics }, bankBonus: L.bankBonus, finaleMult: L.finaleMult || 1, stars, keptPct, n, level: L.level, newBest, score: L.score, kills: L.kills, bestCombo: L.bestCombo, mult: L.mult || 1, total, bestScore, newBestScore, mode: L.mode, modifier: L.modifier });
  if (L.mission) endMission("win", keptPct);
  if (normal) Scenery.preload(themeFor(L.level + 1)).catch(() => {}); // fetch the next theme while the player looks at the stars
}
function explode(x, z, dmg, radius, skip = null) {
  L.fx.push({ x, y: 0.6, z, f: 9, t: 0, dur: 0.4, size: radius * 1.3 });
  if (L.boomSfx <= 0) { sfx("boom"); L.boomSfx = 0.18; }
  for (const e of L.enemies) {
    if (e === skip || e.hp <= 0 || e.state === "dead" || e.state === "dying") continue;
