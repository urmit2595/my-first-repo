   392	      for (let k = 0; k < 4; k++) { const m = new T.Mesh(new T.PlaneBufferGeometry(16, 16).rotateX(-Math.PI / 2), pm); m.renderOrder = 2; m.position.y = 0.04; m.userData.off = [6, -10, -26, -42][k]; m.userData.dx = k % 2 ? 1.6 : -1.6; S.pools.push(m); world.add(m); }
   393	    }
   394	    // sidewalks -------------------------------------------------------------------
   395	    {
   396	      const sw = isPier ? tex("deck", "deck", 0x7a5a3a) : tex("sidewalk", "concrete", 0xa0a0a8), st = isPier ? tile("deck", 3) * 0.65 : tile("sidewalk", 4);
