  el.addEventListener("pointerup", e => e.stopPropagation());
}
beltButtons.forEach((el, i) => el.onclick = e => { e.stopPropagation(); usePowerup(i); });
$("surgeButton").onclick = $("surgeBar").onclick = e => { e.stopPropagation(); useSurge(); };
$("surgeBar").setAttribute("role", "button"); $("surgeBar").setAttribute("aria-label", "Activate SURGE when ready");
$("surgeBar").tabIndex = 0;
$("surgeBar").onkeydown = e => { if (e.key === "Enter") { e.preventDefault(); useSurge(); } };
gameEl.addEventListener("pointerdown", e => {
  if (e.target.closest("button,.panel,#surgeBar") || overControl(e)) return;
  if (state === "home") { setState("play"); sfx("gate"); }
  if (state !== "play" && state !== "boss") return;
